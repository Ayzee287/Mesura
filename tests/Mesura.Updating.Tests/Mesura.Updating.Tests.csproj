<Project Sdk="Microsoft.NET.Sdk">

  <!-- The update component's tests. Everything runs in fresh temporary folders with a fake server (a message handler) and a fake
       installer: no test starts msiexec, touches a real installation or opens a socket. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mesura.Updating\Mesura.Updating.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
