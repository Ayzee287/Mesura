<Project Sdk="Microsoft.NET.Sdk">

  <!-- The setup component's tests. Every file they write is under a fresh temporary folder: no test touches a real
       application's config, and none launches winget (a stand-in replaces it). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mesura.Setup.Windows\Mesura.Setup.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
