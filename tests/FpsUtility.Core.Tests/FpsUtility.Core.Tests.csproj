<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure tests: no hardware, no OS APIs, so they run anywhere (architecture §4.4, §11). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FpsUtility.Core\FpsUtility.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The committed Track A corpus (repo track-a/), re-verified by CorpusTests. -->
  <ItemGroup>
    <None Include="..\..\track-a\**" LinkBase="TrackA\Corpus" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
