<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only tests (architecture §3.1, §11): the collectors' Windows-specific mapping and path rules,
       tested with fake inputs, plus one collection run on the real machine that checks invariants only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FpsUtility.Platform.Windows\FpsUtility.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
