<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Mesura's installer. The wizard asks one thing besides "Install" (0.5): who the copy is for.
         "For all users of this PC" (recommended, the default): Program Files, and Windows asks for administrator approval when the installation
         starts (the ordinary Windows Installer prompt; nothing here avoids it).
         "Only for me": the current user, no administrator rights, no prompt, %LOCALAPPDATA%\Programs\Mesura.
       The same choice is made from the command line with ALLUSERS=1 (every user) or ALLUSERS=2 MSIINSTALLPERUSER=1 (this user), which is what the
       updater passes; there is no folder to choose (0.4.2), INSTALLFOLDER can still be given for a silent install. An update is this same
       package run again over the installed one (major upgrade), so the Windows Installer's transaction is the rollback. What the package
       carries is the program only: user data (%LOCALAPPDATA%\Mesura of each user: settings, history, profiles, logs, staged updates) is
       never part of it, and neither an upgrade nor an uninstall of either kind touches it. No shared data folder exists or is created. -->
  <Package Name="!(loc.ProductName)" Manufacturer="Mesura" Version="$(MsiProductVersion)" UpgradeCode="6C1F6D1E-5B0A-4C54-9E2F-3A7D0B8E41A9"
           Language="!(loc.LanguageId)" Scope="perUserOrMachine" InstallerVersion="500" Compressed="yes">

    <SummaryInformation Description="!(loc.Description)" Manufacturer="Mesura" />
    <Icon Id="MesuraIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="MesuraIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Ayzee287/Mesura" />
    <Property Id="ARPCOMMENTS" Value="$(AppVersion)" />

    <!-- A newer package replaces the installed one in place; the 4th number carries the release candidate, which Windows Installer
         ignores when comparing, so same-version upgrades are allowed (rc1 to rc2 to the release). An older package is refused. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="!(loc.DowngradeError)" Schedule="afterInstallExecute" IgnoreLanguage="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="medium" />

    <!-- The wizard's choice: "machine" (recommended) unless the command line says MESURA_SCOPE=user; the scope page sets ALLUSERS, MSIINSTALLPERUSER and
         INSTALLFOLDER from it. A silent install is unaffected: it has no page, and without properties it stays per-user (nothing to approve). -->
    <Property Id="MESURA_SCOPE" Value="machine" />

    <!-- Where it was installed before (an upgrade and a reinstall go to the same folder, not to the default). -->
    <Property Id="PREVINSTALLDIR">
      <RegistrySearch Id="PrevDirUser" Root="HKCU" Key="Software\Mesura" Name="InstallDir" Type="directory" Bitness="always64" />
    </Property>
    <SetProperty Id="SCOPENOTEUSER" Value="!(loc.ScopeOtherUserCopy)" After="AppSearch" Sequence="ui" Condition="PREVINSTALLDIR AND NOT PREVINSTALLDIRMACHINE" />
    <SetProperty Id="SCOPENOTEMACHINE" Value="!(loc.ScopeOtherMachineCopy)" After="AppSearch" Sequence="ui" Condition="PREVINSTALLDIRMACHINE AND NOT PREVINSTALLDIR" />
    <!-- This very package is already installed (Installed is true only for the product code of THIS package): Windows Installer keeps one copy of a product code, so opening the
         installer again never offers the other scope and never adds a second copy; it goes to Change / Repair / Remove (measured in Windows Sandbox, 2026-11-02). The wizard says so
         on its own page before those choices, naming the scope the copy is in. A different version has another product code and goes through the scope page (SCOPENOTE* above). -->
    <SetProperty Id="SAMECOPYUSER" Value="!(loc.SameCopyUser)" After="AppSearch" Sequence="ui" Condition="Installed AND NOT PATCH AND PREVINSTALLDIR AND NOT PREVINSTALLDIRMACHINE" />
    <SetProperty Id="SAMECOPYMACHINE" Value="!(loc.SameCopyMachine)" After="AppSearch" Sequence="ui" Condition="Installed AND NOT PATCH AND PREVINSTALLDIRMACHINE" />
    <SetProperty Id="SAMECOPYHOWUSER" Value="!(loc.SameCopyHowUser)" After="AppSearch" Sequence="ui" Condition="Installed AND NOT PATCH AND PREVINSTALLDIR AND NOT PREVINSTALLDIRMACHINE" />
    <SetProperty Id="SAMECOPYHOWMACHINE" Value="!(loc.SameCopyHowMachine)" After="AppSearch" Sequence="ui" Condition="Installed AND NOT PATCH AND PREVINSTALLDIRMACHINE" />
    <Property Id="PREVINSTALLDIRMACHINE">
      <RegistrySearch Id="PrevDirMachine" Root="HKLM" Key="Software\Mesura" Name="InstallDir" Type="directory" Bitness="always64" />
    </Property>
    <CustomAction Id="FolderMachineDefault" Property="INSTALLFOLDER" Value="[ProgramFiles64Folder]Mesura" />
    <CustomAction Id="FolderPrevUser" Property="INSTALLFOLDER" Value="[PREVINSTALLDIR]" />
    <CustomAction Id="FolderPrevMachine" Property="INSTALLFOLDER" Value="[PREVINSTALLDIRMACHINE]" />
    <InstallUISequence>
      <Custom Action="FolderMachineDefault" Before="CostFinalize" Condition="ALLUSERS=1 AND NOT INSTALLFOLDER" />
      <Custom Action="FolderPrevUser" After="FolderMachineDefault" Condition="PREVINSTALLDIR AND NOT ALLUSERS=1 AND NOT INSTALLFOLDER" />
      <Custom Action="FolderPrevMachine" After="FolderPrevUser" Condition="PREVINSTALLDIRMACHINE AND ALLUSERS=1 AND NOT INSTALLFOLDER" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="FolderMachineDefault" Before="CostFinalize" Condition="ALLUSERS=1 AND NOT INSTALLFOLDER" />
      <Custom Action="FolderPrevUser" After="FolderMachineDefault" Condition="PREVINSTALLDIR AND NOT ALLUSERS=1 AND NOT INSTALLFOLDER" />
      <Custom Action="FolderPrevMachine" After="FolderPrevUser" Condition="PREVINSTALLDIRMACHINE AND ALLUSERS=1 AND NOT INSTALLFOLDER" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="!(loc.FeatureMain)" Description="!(loc.FeatureMainDescription)" Level="1" AllowAbsent="no" >
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentRef Id="Registration" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <Feature Id="DesktopFeature" Title="!(loc.FeatureDesktop)" Description="!(loc.FeatureDesktopDescription)" Level="2" AllowAbsent="yes">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- The wizard: a welcome page about Mesura, the scope page (0.5), a page with the Install button, progress, finish (with a box to start Mesura).
         No licence, features or folder pages: the licence text is in the install folder, the folder follows the scope, the desktop shortcut is
         there for ADDLOCAL=MainFeature,DesktopFeature on the command line. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <!-- The wizard's pictures (tools\make-installer-art.ps1): the mark and the logo's light, so the installer looks like the program. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(ArtDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(ArtDir)\dialog.bmp" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchMesura)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <CustomAction Id="LaunchMesura" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]Mesura.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <?if $(FailInstall) = 1 ?>
    <!-- Test builds only (tools\build-installer.ps1 -FailInstall): the install fails after the old version was removed (the major upgrade
         removes it first) and before the new files are copied, to prove that the Windows Installer puts the previous version back and
         that the updater reports it. (A failure placed after the product is registered leaves the failed package registered next to the
         restored one; that is a Windows Installer property of failing that late, and no step of this installer can fail there.) Never part of a release. -->
    <CustomAction Id="TestFailInstall" Directory="INSTALLFOLDER" ExeCommand="cmd.exe /c exit 7" Execute="deferred" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="TestFailInstall" Before="InstallFiles" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
    <?endif?>
    <UI>
      <!-- The welcome page leads straight to the page with the Install button (the licence, the features and the folder pages are never shown). -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="MesuraScopeDlg" Order="4" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MesuraScopeDlg" Order="4" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchMesura" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <!-- This package is already installed: a page that says no second copy can be made, between the maintenance welcome and the Change / Repair / Remove choice. -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MesuraSameCopyDlg" Order="4" Condition="SAMECOPYUSER OR SAMECOPYMACHINE" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MesuraSameCopyDlg" Order="4" Condition="SAMECOPYUSER OR SAMECOPYMACHINE" />
    </UI>
  </Package>

  <Fragment>
    <!-- The scope page. Next writes the four properties a scope means: ALLUSERS and MSIINSTALLPERUSER decide where the registration and the shortcuts go and
         whether Windows asks for administrator approval; INSTALLFOLDER is set here because the UI has already resolved it once (a folder found
         by an earlier install is kept: PREVINSTALLDIR and PREVINSTALLDIRMACHINE are the folders found in the registry). The folder is built from
         the environment, not from [ProgramFiles64Folder]: the wizard runs in a per-user context until the installation starts, and there that
         standard folder is %LOCALAPPDATA%\Programs, which would put an "all users" copy in the user's profile. -->
    <UI>
      <Dialog Id="MesuraScopeDlg" Width="370" Height="284" Title="!(loc.ProductName)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="248" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.ScopeTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.ScopeDescription)" />
        <Control Id="ScopeGroup" Type="RadioButtonGroup" X="20" Y="58" Width="330" Height="160" Property="MESURA_SCOPE">
          <RadioButtonGroup Property="MESURA_SCOPE">
            <RadioButton Value="machine" X="0" Y="0" Width="330" Height="18" Text="{\WixUI_Font_Emphasis}!(loc.ScopeMachine)" />
            <RadioButton Value="user" X="0" Y="82" Width="330" Height="18" Text="{\WixUI_Font_Emphasis}!(loc.ScopeUser)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="ScopeMachineNote" Type="Text" X="38" Y="78" Width="312" Height="58" Transparent="yes" NoPrefix="yes" Text="!(loc.ScopeMachineNote)" />
        <Control Id="ScopeUserNote" Type="Text" X="38" Y="160" Width="312" Height="58" Transparent="yes" NoPrefix="yes" Text="!(loc.ScopeUserNote)" />
        <!-- A copy of the other kind is already registered: Windows Installer treats a per-user and an all-users install as two products, so choosing the
             other kind would add a second copy beside it, not replace it. The page says so, and where to remove the old one; the settings are in neither copy. -->
        <Control Id="ScopeCopyNote" Type="Text" X="20" Y="208" Width="330" Height="36" Transparent="yes" NoPrefix="yes" Text="[SCOPENOTEUSER][SCOPENOTEMACHINE]" />
        <Control Id="Back" Type="PushButton" X="180" Y="257" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="257" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="ALLUSERS" Value="1" Condition="MESURA_SCOPE = &quot;machine&quot;" Order="1" />
          <Publish Property="MSIINSTALLPERUSER" Value="{}" Condition="MESURA_SCOPE = &quot;machine&quot;" Order="2" />
          <Publish Property="ALLUSERS" Value="2" Condition="MESURA_SCOPE = &quot;user&quot;" Order="3" />
          <Publish Property="MSIINSTALLPERUSER" Value="1" Condition="MESURA_SCOPE = &quot;user&quot;" Order="4" />
          <Publish Property="INSTALLFOLDER" Value="[PREVINSTALLDIRMACHINE]" Condition="MESURA_SCOPE = &quot;machine&quot; AND PREVINSTALLDIRMACHINE" Order="5" />
          <Publish Property="INSTALLFOLDER" Value="[%ProgramW6432]\Mesura" Condition="MESURA_SCOPE = &quot;machine&quot; AND NOT PREVINSTALLDIRMACHINE" Order="6" />
          <Publish Property="INSTALLFOLDER" Value="[PREVINSTALLDIR]" Condition="MESURA_SCOPE = &quot;user&quot; AND PREVINSTALLDIR" Order="7" />
          <Publish Property="INSTALLFOLDER" Value="[%LOCALAPPDATA]\Programs\Mesura" Condition="MESURA_SCOPE = &quot;user&quot; AND NOT PREVINSTALLDIR" Order="8" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="9" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="257" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>

  <Fragment>
    <!-- "This installer cannot add a second copy": shown when the package opened is the one already installed (see SAMECOPYUSER and SAMECOPYMACHINE). The text names the scope of the installed copy. -->
    <UI>
      <Dialog Id="MesuraSameCopyDlg" Width="370" Height="284" Title="!(loc.ProductName)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="248" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.SameCopyTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.SameCopyDescription)" />
        <!-- Each property is one short sentence (a custom action's Target is limited to 255 characters, ICE03); the paragraph between them is the same for both scopes. -->
        <Control Id="State" Type="Text" X="20" Y="58" Width="330" Height="26" Transparent="yes" NoPrefix="yes" Text="[SAMECOPYUSER][SAMECOPYMACHINE]" />
        <Control Id="Why" Type="Text" X="20" Y="92" Width="330" Height="62" Transparent="yes" NoPrefix="yes" Text="!(loc.SameCopyWhy)" />
        <Control Id="How" Type="Text" X="20" Y="162" Width="330" Height="64" Transparent="yes" NoPrefix="yes" Text="[SAMECOPYHOWUSER][SAMECOPYHOWMACHINE]" />
        <Control Id="Back" Type="PushButton" X="180" Y="257" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="MaintenanceWelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="257" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="257" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>

  <Fragment>
    <!-- The default place: the current user's Programs folder. For every user, Program Files. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Mesura" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <!-- Every file of the build (the app, the command line in cli\, the licence and notices, the diagnostic scripts in tools\). -->
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- What the updater and the app read to know where Mesura is installed, and for whom. -->
    <Component Id="Registration" Directory="INSTALLFOLDER" Bitness="always64">
      <RegistryValue Root="HKMU" Key="Software\Mesura" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Mesura" Name="Version" Type="string" Value="$(AppVersion)" />
      <RegistryValue Root="HKMU" Key="Software\Mesura" Name="Language" Type="string" Value="!(loc.LanguageCode)" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Bitness="always64">
      <Shortcut Id="StartMenuMesura" Name="Mesura" Description="!(loc.Description)" Target="[INSTALLFOLDER]Mesura.exe" WorkingDirectory="INSTALLFOLDER" Icon="MesuraIcon" />
      <RegistryValue Root="HKCU" Key="Software\Mesura\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Bitness="always64">
      <Shortcut Id="DesktopMesura" Name="Mesura" Description="!(loc.Description)" Target="[INSTALLFOLDER]Mesura.exe" WorkingDirectory="INSTALLFOLDER" Icon="MesuraIcon" />
      <RegistryValue Root="HKCU" Key="Software\Mesura\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
