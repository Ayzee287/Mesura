<Project Sdk="Microsoft.NET.Sdk">

  <!-- The release machine's tool (docs/updates.md): makes the update signing key, and signs the manifest of a release. It is not
       shipped. The private key is a file the owner keeps outside the repository; nothing here ever prints or stores it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mesura.ReleaseTool</RootNamespace>
    <AssemblyName>mesura-release</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mesura.Core\Mesura.Core.csproj" />
  </ItemGroup>

</Project>
