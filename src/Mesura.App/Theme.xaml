<!-- Mesura's design system (redesign 2026-10, docs/redesign-2026-10.md §1; refined in D031, docs/design-2026-10-workflows.md §2):
     near-black layered surfaces told apart by light rather than outlines, translucent hairline borders, cool off-white ink,
     an ink primary button, one restrained mint accent for selection, focus and progress only, quiet status colours, and
     type doing the hierarchy. Motion is short and only shows a change of state. No third-party theme (architecture §3.3).
     Every colour, font and shape the pages use is defined here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:Mesura.App">

    <!-- ===== Tokens ===== -->
    <Color x:Key="BgColor">#FF0B0C0F</Color>
    <Color x:Key="SurfaceColor">#FF111317</Color>
    <Color x:Key="RaisedColor">#FF181B20</Color>
    <Color x:Key="HoverColor">#FF1F2228</Color>
    <!-- Hairlines are translucent white, so a border reads the same on every layer it sits on. -->
    <Color x:Key="StrokeColor">#17FFFFFF</Color>
    <Color x:Key="StrokeStrongColor">#29FFFFFF</Color>
    <Color x:Key="TextColor">#FFEDF0F7</Color>
    <Color x:Key="TextSecondaryColor">#FF9AA1B5</Color>
    <Color x:Key="TextTertiaryColor">#FF666D82</Color>
    <Color x:Key="AccentColor">#FF62D6B8</Color>
    <Color x:Key="AccentHoverColor">#FF80E2C9</Color>
    <Color x:Key="AccentPressedColor">#FF4ABFA1</Color>
    <Color x:Key="InkColor">#FFE8ECF5</Color>
    <Color x:Key="SuccessColor">#FF52C98B</Color>
    <Color x:Key="WarningColor">#FFE9B65C</Color>
    <Color x:Key="DangerColor">#FFEE6E62</Color>
    <Color x:Key="InfoColor">#FF8AA9F5</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeStrong" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtle" Color="#2262D6B8" />
    <SolidColorBrush x:Key="OnAccent" Color="#FF06231C" />
    <!-- The primary action: ink on the background, as the rest of the page is ink on dark. -->
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkHover" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InkPressed" Color="#FFCBD1DE" />
    <SolidColorBrush x:Key="OnInk" Color="#FF0B0C0F" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtle" Color="#1E52C98B" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtle" Color="#1EE9B65C" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSubtle" Color="#1EEE6E62" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSubtle" Color="#1E8AA9F5" />
    <SolidColorBrush x:Key="NeutralSubtle" Color="#10EDF0F7" />

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>

    <!-- Icons (Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10: the same code points). -->
    <sys:String x:Key="IconOptimize">&#xEC4A;</sys:String>
    <sys:String x:Key="IconApps">&#xE74C;</sys:String>
    <sys:String x:Key="IconConfigurations">&#xE9E9;</sys:String>
    <sys:String x:Key="IconProfiles">&#xE77B;</sys:String>
    <sys:String x:Key="IconActivity">&#xE81C;</sys:String>
    <sys:String x:Key="IconSettings">&#xE713;</sys:String>
    <sys:String x:Key="IconSearch">&#xE721;</sys:String>
    <sys:String x:Key="IconRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="IconCheck">&#xE73E;</sys:String>
    <sys:String x:Key="IconChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="IconChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="IconBack">&#xE72B;</sys:String>
    <sys:String x:Key="IconUndo">&#xE7A7;</sys:String>
    <sys:String x:Key="IconInfo">&#xE946;</sys:String>
    <sys:String x:Key="IconWarning">&#xE7BA;</sys:String>
    <sys:String x:Key="IconError">&#xEA39;</sys:String>
    <sys:String x:Key="IconDone">&#xE930;</sys:String>
    <sys:String x:Key="IconClose">&#xE711;</sys:String>
    <sys:String x:Key="IconDownload">&#xE896;</sys:String>
    <sys:String x:Key="IconFolder">&#xE838;</sys:String>
    <sys:String x:Key="IconSave">&#xE74E;</sys:String>
    <sys:String x:Key="IconOpen">&#xE8E5;</sys:String>
    <sys:String x:Key="IconRun">&#xE768;</sys:String>
    <sys:String x:Key="IconShield">&#xEA18;</sys:String>
    <sys:String x:Key="IconDesktop">&#xE7F4;</sys:String>
    <sys:String x:Key="IconLaptop">&#xE7F8;</sys:String>
    <sys:String x:Key="IconGpu">&#xE950;</sys:String>
    <sys:String x:Key="IconWindows">&#xE770;</sys:String>
    <sys:String x:Key="IconImage">&#xE81E;</sys:String>
    <sys:String x:Key="IconGuide">&#xE8A5;</sys:String>
    <sys:String x:Key="IconKey">&#xE8D7;</sys:String>
    <sys:String x:Key="IconRuntime">&#xEA86;</sys:String>
    <sys:String x:Key="IconArchive">&#xE7B8;</sys:String>
    <sys:String x:Key="IconExternal">&#xE8A7;</sys:String>
    <sys:String x:Key="IconResume">&#xE895;</sys:String>

    <!-- ===== Converters ===== -->
    <local:StateBrushConverter x:Key="StateBrush" />
    <local:StateBrushConverter x:Key="StateBackground" Background="True" />
    <local:PresenceToVisibilityConverter x:Key="Presence" />
    <local:HalfWidthConverter x:Key="HalfWidth" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InvertConverter x:Key="Invert" />

    <!-- ===== Base ===== -->
    <!-- Implicit styles don't reach a Window subclass, so each window sets Style="{StaticResource AppWindow}". -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- ===== Type ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Tertiary" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- A card on the setup plan: one line of state, one switch, details on demand; hover lifts its hairline. -->
    <Style x:Key="PlanCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The square behind a card's glyph or an app's icon. -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Content that appears (a card's details, a result): it fades and settles in, 160 ms, nothing more. -->
    <Style x:Key="Reveal" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-4" To="0" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Stroke}" />
    </Style>

    <!-- A row in a list: hover lights it. -->
    <Style x:Key="Row" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="10,8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Raised}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A status pill: its colours come from the state word (StateBrush / StateBackground). -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,2,9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A quiet tag: impact, "restart". -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeutralSubtle}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2,7,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- A banner after a run or for something that needs attention; the colours come from the state. -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- ===== Focus ===== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource Accent}" StrokeThickness="1.5" RadiusX="9" RadiusY="9" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- Secondary (the default button). -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Hover}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Surface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one action that changes the PC: ink, the strongest contrast on the page, with dark text. -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Ink}" />
        <Setter Property="Foreground" Value="{StaticResource OnInk}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource InkHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource InkPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quiet text button: secondary actions in a row or a card. -->
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inline link: accent text. -->
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A square icon button (refresh, back). Content is a glyph. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ===== Navigation ===== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="B" Height="40" CornerRadius="{StaticResource ControlRadius}" Background="Transparent" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Width="20" FontSize="16" />
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A category in a page's own rail (All settings): its name, and on the right what it holds. -->
    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="B" MinHeight="34" CornerRadius="{StaticResource ControlRadius}" Background="Transparent" Padding="12,6,10,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Bar" Width="3" Height="14" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A filter chip (one of a group). -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" Height="28" CornerRadius="14" Padding="12,0" BorderThickness="1"
                            BorderBrush="{StaticResource Stroke}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentSubtle}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A segmented control item (language, configuration source). -->
    <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- A large selectable card: the outcome choice on Optimize. -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" CornerRadius="{StaticResource CardRadius}" BorderThickness="1.5" Padding="18,14"
                            BorderBrush="{StaticResource Stroke}" Background="{StaticResource Surface}">
                        <Grid>
                            <ContentPresenter />
                            <Border x:Name="Tick" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    BorderThickness="1.5" BorderBrush="{StaticResource StrokeStrong}">
                                <TextBlock x:Name="TickGlyph" Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="11"
                                           HorizontalAlignment="Center" Foreground="{StaticResource OnAccent}" Visibility="Collapsed" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Tick" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Tick" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="TickGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{StaticResource StrokeStrong}" Background="Transparent" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="{StaticResource OnAccent}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A switch for on/off preferences. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1.5"
                            BorderBrush="{StaticResource TextSecondary}" Background="Transparent">
                        <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="{StaticResource TextSecondary}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource OnAccent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="Thumb" Property="Width" Value="12" />
                            <Setter TargetName="Thumb" Property="Height" Value="12" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A masked field (a product key): the text box's look. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A search box: a magnifier, and the placeholder (Tag) while it is empty. -->
    <Style x:Key="Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconSearch}" FontSize="13"
                                       Foreground="{StaticResource TextTertiary}" Margin="12,0,0,0" HorizontalAlignment="Left" />
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextTertiary}"
                                       Margin="36,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="34,0,10,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A read-only text area (the session log): selectable, monospace. -->
    <Style x:Key="LogBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Disclosure ===== -->
    <Style x:Key="Disclosure" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" Foreground="{TemplateBinding Foreground}"
                                      Content="{TemplateBinding Header}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="{StaticResource IconChevronRight}" FontSize="10"
                                                       Foreground="{StaticResource TextTertiary}" Margin="0,1,8,0" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="18,2,0,4" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A chevron toggle that expands a row's details. -->
    <Style x:Key="ChevronToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" CornerRadius="6" Background="Transparent">
                        <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="{StaticResource IconChevronDown}" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextTertiary}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Hover}" />
                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lists ===== -->
    <Style x:Key="SelectableList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!-- The items draw the focus ring; the list around them must not add WPF's default dotted rectangle. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="SelectableItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="B" CornerRadius="{StaticResource ControlRadius}" Background="Transparent" Padding="10,8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Progress ===== -->
    <Style x:Key="Busy" TargetType="ProgressBar">
        <Setter Property="Height" Value="2" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{StaticResource Stroke}" CornerRadius="1" ClipToBounds="True">
                        <Rectangle Width="140" HorizontalAlignment="Left" Fill="{StaticResource Accent}" RadiusX="1" RadiusY="1">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="Move" X="-140" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Run">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Move" Storyboard.TargetProperty="X" From="-140" To="1600" Duration="0:0:1.8">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Run" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tooltips and scrollbars ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{StaticResource StrokeStrong}" CornerRadius="3" Margin="3,2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
