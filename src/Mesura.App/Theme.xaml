<!-- Mesura's design system, "Glass" (0.3, docs/redesign-2026-11.md): one ink-blue field with soft ambient light behind it, panels
     that are light-on-dark glass (translucent white washes with a lit rim, so what sits behind them shows through), one
     indigo-violet accent for selection, focus and the primary action, a pointer-following glow on the surfaces you can act
     on (GlowBorder), quiet status colours and type doing the hierarchy. Motion is short and only shows a change of state.
     No third-party theme (architecture §3.3). Every colour, font and shape the pages use is defined here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:Mesura.App">

    <!-- ===== Tokens ===== -->
    <!-- Palette (0.4 "Graphite"): a neutral near-black field, white-wash glass, one silver-blue accent for selection, focus and the primary
         action, and mint (the brand's measuring bar) only where something is verified or done. Risk and warning colours keep their meaning;
         nothing else is coloured. -->
    <Color x:Key="BgColor">#FF08090B</Color>
    <!-- Panels are washes of white over the field, never solid greys: the ambient light behind a panel shows through it, which is
         what makes the surfaces read as glass. Popups and dialogs sit over page content and are opaque (PopoverColor). -->
    <Color x:Key="SurfaceColor">#0DFFFFFF</Color>
    <Color x:Key="RaisedColor">#17FFFFFF</Color>
    <Color x:Key="HoverColor">#21FFFFFF</Color>
    <Color x:Key="PopoverColor">#FF16181C</Color>
    <!-- Hairlines are translucent white, so a border reads the same on every layer it sits on. -->
    <Color x:Key="StrokeColor">#14FFFFFF</Color>
    <Color x:Key="StrokeStrongColor">#2AFFFFFF</Color>
    <Color x:Key="TextColor">#FFF3F4F7</Color>
    <Color x:Key="TextSecondaryColor">#FFB0B5BF</Color>
    <Color x:Key="TextTertiaryColor">#FF8F95A1</Color>
    <Color x:Key="AccentColor">#FFC6D3F0</Color>
    <Color x:Key="AccentHoverColor">#FFE2EAFA</Color>
    <Color x:Key="AccentPressedColor">#FF9FB0D6</Color>
    <Color x:Key="AccentBlueColor">#FF9DB2E6</Color>
    <Color x:Key="SuccessColor">#FF5FDDB2</Color>
    <Color x:Key="WarningColor">#FFF0B65A</Color>
    <Color x:Key="DangerColor">#FFFF7480</Color>
    <Color x:Key="InfoColor">#FF8DB9F2</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeStrong" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtle" Color="#1FC6D3F0" />
    <SolidColorBrush x:Key="AccentRim" Color="#55C6D3F0" />
    <!-- Text and glyphs that sit on the accent fill: near-black, so the pale button reads at 12:1. -->
    <SolidColorBrush x:Key="OnAccent" Color="#FF0B0D12" />
    <SolidColorBrush x:Key="Popover" Color="{StaticResource PopoverColor}" />
    <!-- The primary action: a silver-pearl sweep with dark text; the light under it comes up on hover. -->
    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF1F4FB" Offset="0" />
        <GradientStop Color="#FFC9D4EC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFillHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFD6E0F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFillPressed" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFDCE2F0" Offset="0" />
        <GradientStop Color="#FFB4C0DC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtle" Color="#1F5FDDB2" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtle" Color="#1FF0B65A" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSubtle" Color="#1FFF7480" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSubtle" Color="#1F8DB9F2" />
    <SolidColorBrush x:Key="NeutralSubtle" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="CardHover" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="SidebarSurface" Color="#0AFFFFFF" />
    <!-- The lit rim of a glass panel: bright where light would catch the top-left edge, fading to a hairline. -->
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.4" />
        <GradientStop Color="#0EFFFFFF" Offset="0.7" />
        <GradientStop Color="#24FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- The panel's own sheen: a whisper of light from the top, so a large surface isn't one flat tone. -->
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#17FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.5" />
        <GradientStop Color="#0BFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- The command dock: denser than a card, because it floats over the page content and must stay readable over it. -->
    <LinearGradientBrush x:Key="DockSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0202328" Offset="0" />
        <GradientStop Color="#F0151719" Offset="1" />
    </LinearGradientBrush>
    <!-- Ambient light behind everything (AmbientField): a cool key light that follows the pointer with inertia, a broad cool light
         and a warm counter-light; all neutral, all low. -->
    <RadialGradientBrush x:Key="OrbKey" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2CC6D3F0" Offset="0" />
        <GradientStop Color="#10C6D3F0" Offset="0.5" />
        <GradientStop Color="#00C6D3F0" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbCool" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#26AFC2EA" Offset="0" />
        <GradientStop Color="#0DAFC2EA" Offset="0.5" />
        <GradientStop Color="#00AFC2EA" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbWarm" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#1CE8D0AE" Offset="0" />
        <GradientStop Color="#08E8D0AE" Offset="0.5" />
        <GradientStop Color="#00E8D0AE" Offset="1" />
    </RadialGradientBrush>

    <!-- Type (0.4): Onest for the interface (drawn for Cyrillic and Latin together), JetBrains Mono for measured values, Spectral Light
         Italic for the few expressive moments (a hero word, a large figure). The three ship inside the executable (SIL OFL 1.1). -->
    <FontFamily x:Key="DisplayFont">/Mesura;component/Assets/Fonts/#Onest, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">/Mesura;component/Assets/Fonts/#Onest, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">/Mesura;component/Assets/Fonts/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="ExpressiveFont">/Mesura;component/Assets/Fonts/#Spectral, Georgia, Segoe UI</FontFamily>

    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <CornerRadius x:Key="ControlRadius">10</CornerRadius>
    <!-- One gutter for every page, so the pages line up when you move between them. -->
    <Thickness x:Key="PageGutter">36,0,36,0</Thickness>
    <Color x:Key="GlowColor">#FFDCE6FF</Color>

    <!-- Icons (Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10: the same code points). -->
    <sys:String x:Key="IconOptimize">&#xEC4A;</sys:String>
    <sys:String x:Key="IconApps">&#xE74C;</sys:String>
    <sys:String x:Key="IconConfigurations">&#xE9E9;</sys:String>
    <sys:String x:Key="IconProfiles">&#xE77B;</sys:String>
    <sys:String x:Key="IconActivity">&#xE81C;</sys:String>
    <sys:String x:Key="IconSettings">&#xE713;</sys:String>
    <sys:String x:Key="IconSearch">&#xE721;</sys:String>
    <sys:String x:Key="IconRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="IconCheck">&#xE73E;</sys:String>
    <sys:String x:Key="IconChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="IconChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="IconBack">&#xE72B;</sys:String>
    <sys:String x:Key="IconUndo">&#xE7A7;</sys:String>
    <sys:String x:Key="IconInfo">&#xE946;</sys:String>
    <sys:String x:Key="IconWarning">&#xE7BA;</sys:String>
    <sys:String x:Key="IconError">&#xEA39;</sys:String>
    <sys:String x:Key="IconDone">&#xE930;</sys:String>
    <sys:String x:Key="IconClose">&#xE711;</sys:String>
    <sys:String x:Key="IconDownload">&#xE896;</sys:String>
    <sys:String x:Key="IconFolder">&#xE838;</sys:String>
    <sys:String x:Key="IconSave">&#xE74E;</sys:String>
    <sys:String x:Key="IconOpen">&#xE8E5;</sys:String>
    <sys:String x:Key="IconRun">&#xE768;</sys:String>
    <sys:String x:Key="IconShield">&#xEA18;</sys:String>
    <sys:String x:Key="IconDesktop">&#xE7F4;</sys:String>
    <sys:String x:Key="IconLaptop">&#xE7F8;</sys:String>
    <sys:String x:Key="IconGpu">&#xE950;</sys:String>
    <sys:String x:Key="IconWindows">&#xE770;</sys:String>
    <sys:String x:Key="IconImage">&#xE81E;</sys:String>
    <sys:String x:Key="IconGuide">&#xE8A5;</sys:String>
    <sys:String x:Key="IconKey">&#xE8D7;</sys:String>
    <sys:String x:Key="IconRuntime">&#xEA86;</sys:String>
    <sys:String x:Key="IconArchive">&#xE7B8;</sys:String>
    <sys:String x:Key="IconExternal">&#xE8A7;</sys:String>
    <sys:String x:Key="IconResume">&#xE895;</sys:String>
    <sys:String x:Key="IconTweaks">&#xE9E9;</sys:String>
    <sys:String x:Key="IconDebloat">&#xE74D;</sys:String>
    <sys:String x:Key="IconSupport">&#xE9CE;</sys:String>
    <sys:String x:Key="IconMore">&#xE712;</sys:String>
    <sys:String x:Key="IconCopy">&#xE8C8;</sys:String>
    <sys:String x:Key="IconSystem">&#xE9D9;</sys:String>
    <sys:String x:Key="IconUpdate">&#xE777;</sys:String>
    <sys:String x:Key="IconMemory">&#xE964;</sys:String>
    <sys:String x:Key="IconStorage">&#xEDA2;</sys:String>
    <sys:String x:Key="IconBoard">&#xE950;</sys:String>
    <sys:String x:Key="IconMonitor">&#xE7F4;</sys:String>
    <sys:String x:Key="IconBattery">&#xE83F;</sys:String>
    <sys:String x:Key="IconNetwork">&#xE968;</sys:String>
    <sys:String x:Key="IconExport">&#xEDE1;</sys:String>

    <!-- ===== Converters ===== -->
    <local:StateBrushConverter x:Key="StateBrush" />
    <local:StateBrushConverter x:Key="StateBackground" Background="True" />
    <local:PresenceToVisibilityConverter x:Key="Presence" />
    <local:HalfWidthConverter x:Key="HalfWidth" />
    <local:CardColumnsConverter x:Key="CardColumns" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InvertConverter x:Key="Invert" />

    <!-- ===== Base ===== -->
    <!-- Implicit styles don't reach a Window subclass, so each window sets Style="{StaticResource AppWindow}". -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- ===== Type ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Tertiary" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <!-- A glass panel: a white wash over the field, a lit rim. Put it on a GlowBorder when the whole surface can be acted on. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassSheen}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- A card on the setup plan: one line of state, one switch, details on demand; the pointer lights it. -->
    <Style x:Key="PlanCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- The command dock (MainWindow): navigation on the left, the page's selection summary and its one primary action on the right, in one
         capsule at the bottom of the window. Denser than a card because it floats over scrolling content; the shared light still reaches it. -->
    <Style x:Key="DockGlass" TargetType="{x:Type local:GlowBorder}">
        <Setter Property="Background" Value="{StaticResource DockSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="GlowColor" Value="{StaticResource GlowColor}" />
        <Setter Property="GlowStrength" Value="0.55" />
        <Setter Property="Reach" Value="220" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.55" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Background" Value="{StaticResource Stroke}" />
    </Style>

    <!-- A card that is a control (a setting, an outcome, a stat): same glass, the glow follows the pointer. -->
    <Style x:Key="GlowCard" TargetType="{x:Type local:GlowBorder}">
        <Setter Property="Background" Value="{StaticResource GlassSheen}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="GlowColor" Value="{StaticResource GlowColor}" />
    </Style>

    <Style x:Key="PlanGlow" TargetType="{x:Type local:GlowBorder}" BasedOn="{StaticResource GlowCard}">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- The square behind a card's glyph or an app's icon. -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Content that appears (a card's details, a result): it fades and settles in, 160 ms, nothing more. -->
    <Style x:Key="Reveal" TargetType="FrameworkElement">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-4" To="0" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Stroke}" />
    </Style>

    <!-- A row in a list: hover lights it. -->
    <Style x:Key="Row" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="10,8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Raised}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A status pill: its colours come from the state word (StateBrush / StateBackground). -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,2,9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A quiet tag: impact, "restart". -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeutralSubtle}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2,7,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- A banner after a run or for something that needs attention; the colours come from the state. -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- ===== Focus ===== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource Accent}" StrokeThickness="1.5" RadiusX="9" RadiusY="9" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- Secondary (the default button). -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Hover}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one action that changes the PC: the accent sweep with white text; the light under it comes up on hover. -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentFill}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Halo" CornerRadius="{StaticResource ControlRadius}" Background="{StaticResource Accent}" Opacity="0" Margin="0,4,0,-4">
                            <Border.Effect>
                                <BlurEffect Radius="16" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="#33FFFFFF" BorderThickness="1"
                                CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentFillHover}" />
                            <Setter TargetName="Halo" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentFillPressed}" />
                            <Setter TargetName="Halo" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Stroke}" />
                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quiet text button: secondary actions in a row or a card. -->
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inline link: accent text. -->
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A square icon button (refresh, back). Content is a glyph. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ===== Navigation ===== -->
    <!-- A page in the dock: its glyph; the page you are on opens into a lit pill with its name, the others keep a tooltip and an automation name.
         In a narrow window (Chrome.Compact) even the open one is glyph only. -->
    <Style x:Key="DockItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <local:GlowBorder x:Name="B" Height="40" MinWidth="40" CornerRadius="15" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                      GlowColor="{StaticResource GlowColor}" GlowStrength="0.8" GlowRadius="120" Reach="160" Padding="11,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Width="18" FontSize="17" TextAlignment="Center" />
                            <ContentPresenter x:Name="Label" Margin="9,0,2,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </local:GlowBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                            <Setter TargetName="B" Property="IsHeld" Value="True" />
                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="local:Chrome.Compact" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The dock's "more" button and the entries in its menu use the same look. -->
    <Style x:Key="DockMore" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <local:GlowBorder x:Name="B" Height="40" Width="40" CornerRadius="15" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                      GlowColor="{StaticResource GlowColor}" GlowStrength="0.8" GlowRadius="120" Reach="160">
                        <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{StaticResource IconMore}" FontSize="17" HorizontalAlignment="Center" />
                    </local:GlowBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                            <Setter TargetName="B" Property="IsHeld" Value="True" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in the dock's "more" menu. -->
    <Style x:Key="DockMenuItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" Height="38" CornerRadius="11" Background="Transparent" Padding="12,0" MinWidth="190">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Width="18" FontSize="16" TextAlignment="Center" />
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A category in a page's own rail (All settings): its name, and on the right what it holds. -->
    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="B" MinHeight="34" CornerRadius="{StaticResource ControlRadius}" Background="Transparent" Padding="12,6,10,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Bar" Width="3" Height="14" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A filter chip (one of a group). -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" Height="28" CornerRadius="14" Padding="12,0" BorderThickness="1"
                            BorderBrush="{StaticResource Stroke}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentSubtle}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="#55C6D3F0" />
                            <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A segmented control item (language, configuration source). -->
    <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- A large selectable card: the outcome choice on Optimize. -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <local:GlowBorder x:Name="B" Style="{StaticResource GlowCard}" BorderThickness="1" Padding="20,16">
                        <Grid>
                            <ContentPresenter />
                            <Border x:Name="Tick" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    BorderThickness="1.5" BorderBrush="{StaticResource StrokeStrong}">
                                <TextBlock x:Name="TickGlyph" Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="11"
                                           HorizontalAlignment="Center" Foreground="{StaticResource OnAccent}" Visibility="Collapsed" />
                            </Border>
                        </Grid>
                    </local:GlowBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentSubtle}" />
                            <Setter TargetName="B" Property="IsHeld" Value="True" />
                            <Setter TargetName="Tick" Property="Background" Value="{StaticResource AccentFill}" />
                            <Setter TargetName="Tick" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="TickGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{StaticResource StrokeStrong}" Background="Transparent" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="{StaticResource OnAccent}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentFill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A switch for on/off preferences. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" BorderThickness="1"
                            BorderBrush="{StaticResource StrokeStrong}" Background="{StaticResource Raised}">
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{StaticResource TextSecondary}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbMove" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextTertiary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentFill}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#33FFFFFF" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFFFF" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbMove" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A masked field (a product key): the text box's look. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A search box: a magnifier, and the placeholder (Tag) while it is empty. -->
    <Style x:Key="Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconSearch}" FontSize="13"
                                       Foreground="{StaticResource TextTertiary}" Margin="12,0,0,0" HorizontalAlignment="Left" />
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextTertiary}"
                                       Margin="36,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="34,0,10,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A read-only text area (the session log): selectable, monospace. -->
    <Style x:Key="LogBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Disclosure ===== -->
    <Style x:Key="Disclosure" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" Foreground="{TemplateBinding Foreground}"
                                      Content="{TemplateBinding Header}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="{StaticResource IconChevronRight}" FontSize="10"
                                                       Foreground="{StaticResource TextTertiary}" Margin="0,1,8,0" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="18,2,0,4" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A chevron toggle that expands a row's details. -->
    <Style x:Key="ChevronToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" CornerRadius="6" Background="Transparent">
                        <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="{StaticResource IconChevronDown}" FontSize="11"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextTertiary}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Hover}" />
                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lists ===== -->
    <Style x:Key="SelectableList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!-- The items draw the focus ring; the list around them must not add WPF's default dotted rectangle. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="SelectableItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="B" CornerRadius="{StaticResource ControlRadius}" Background="Transparent" Padding="10,8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group in a grouped list: its header and its items, with none of the default container's padding (the cards line up with the page). -->
    <Style x:Key="FlatGroupItem" TargetType="GroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <StackPanel>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ItemsPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A setting as a card in the Tweaks grid: the card is the list item, so selecting it opens the details drawer. -->
    <Style x:Key="CardItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <local:GlowBorder x:Name="B" Style="{StaticResource GlowCard}">
                        <ContentPresenter />
                    </local:GlowBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentSubtle}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="B" Property="IsHeld" Value="True" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Progress ===== -->
    <Style x:Key="Busy" TargetType="ProgressBar">
        <Setter Property="Height" Value="2" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{StaticResource Stroke}" CornerRadius="1" ClipToBounds="True">
                        <Rectangle Width="140" HorizontalAlignment="Left" Fill="{StaticResource Accent}" RadiusX="1" RadiusY="1">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="Move" X="-140" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Run">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Move" Storyboard.TargetProperty="X" From="-140" To="1600" Duration="0:0:1.8">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Run" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A measured share (memory in use, a volume's used space): a slim track and a fill in the colour of its tone. -->
    <Style x:Key="Meter" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{StaticResource Raised}" CornerRadius="3" Height="6">
                        <Border x:Name="PART_Track" CornerRadius="3" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tooltips and scrollbars ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Popover}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{StaticResource StrokeStrong}" CornerRadius="3" Margin="3,2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
