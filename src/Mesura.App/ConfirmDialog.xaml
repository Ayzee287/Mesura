<Window x:Class="Mesura.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        KeyDown="OnKeyDown" Style="{StaticResource AppWindow}" Background="Transparent">
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="18" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" MaxHeight="320" x:Name="ItemsHost">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,7,0,0" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="NoteBox" Grid.Row="3" Style="{StaticResource Inset}" Margin="0,14,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconInfo}" FontSize="14" Foreground="{StaticResource Info}"
                               VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock x:Name="NoteText" Grid.Column="1" Style="{StaticResource Caption}" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" IsCancel="True" MinWidth="96" Click="OnCancel" />
                <Button x:Name="OkButton" Style="{StaticResource Primary}" IsDefault="True" MinWidth="110" Margin="8,0,0,0" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
