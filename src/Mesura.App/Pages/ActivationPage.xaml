<UserControl x:Class="Mesura.App.Pages.ActivationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <UserControl.Resources>
        <!-- One licence: its state, one sentence, one primary action; the facts behind "Technical details". -->
        <DataTemplate x:Key="LicenseCardTemplate" DataType="{x:Type l:LicenseCard}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="40" Height="40">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <!-- The same two lines for Windows and Office: what it is, then where it stands in the expressive italic, in the colour of the state. -->
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Tertiary}" FontSize="13" FontWeight="Medium" />
                        <TextBlock Text="{Binding State}" FontFamily="{StaticResource ExpressiveFont}" FontStyle="Italic" FontWeight="Light" FontSize="28" LineHeight="32" Margin="0,2,0,0"
                                   Foreground="{Binding Tone, Converter={StaticResource StateBrush}}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Line}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />

                        <!-- The last attempt, when it failed: on the card it belongs to -->
                        <Border Style="{StaticResource Inset}" Background="{StaticResource DangerSubtle}" Margin="0,12,0,0"
                                Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconError}" FontSize="14" Foreground="{StaticResource Danger}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Problem}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" LineHeight="18" />
                            </Grid>
                        </Border>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="{Binding PrimaryLabel}" Style="{StaticResource Primary}" Margin="0,0,8,0"
                                    Command="{Binding DataContext.Primary, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    Visibility="{Binding PrimaryIsStrong, Converter={StaticResource BoolToVisibility}}" />
                            <Button Margin="0,0,8,0" AutomationProperties.Name="{Binding PrimaryLabel}"
                                    Command="{Binding DataContext.Primary, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    Visibility="{Binding PrimaryIsQuiet, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconExternal}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding PrimaryLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Content="{l:T Activation.UseOtherKey}" Style="{StaticResource Ghost}" Margin="0,0,8,0"
                                    Command="{Binding DataContext.EnterKey, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    Visibility="{Binding OffersKey, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Link}" VerticalAlignment="Center" Margin="4,0,0,0" AutomationProperties.Name="{l:T Activation.Help}"
                                    Command="{Binding DataContext.Help, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <TextBlock Text="{l:T Activation.Help}" />
                            </Button>
                        </WrapPanel>

                        <Expander Style="{StaticResource Disclosure}" Header="{l:T Details.Technical}" Margin="0,10,0,0"
                                  Visibility="{Binding HasFacts, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Facts}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type l:LicenseFact}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Tertiary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Caption}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ProblemDetail}" Style="{StaticResource Mono}" Margin="0,6,0,0"
                                           Visibility="{Binding ProblemDetail, Converter={StaticResource Presence}}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,0,36,28">
            <Grid>
                <l:PageHero Title="{l:T Nav.Activation}" Subtitle="{Binding Status}" HeroMargin="0,28,60,12" />
                <Button Content="{StaticResource IconRefresh}" Style="{StaticResource IconButton}" Command="{Binding Refresh}" AutomationProperties.Name="{l:T Common.Refresh}"
                        ToolTip="{l:T Common.Refresh}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,0,0" />
            </Grid>
            <ProgressBar Style="{StaticResource Busy}" Margin="0,14,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding AdminNote}" Style="{StaticResource Caption}" Foreground="{StaticResource Warning}" Margin="0,12,0,0"
                       Visibility="{Binding AdminNote, Converter={StaticResource Presence}}" />
            <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Margin="0,12,0,0" Focusable="False" />

            <!-- The key field: masked, checked here, given to Windows and cleared. -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="{StaticResource StrokeStrong}"
                    Visibility="{Binding EnteringKey, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Style="{StaticResource Reveal}">
                    <TextBlock Text="{Binding KeyTitle}" Style="{StaticResource BodyStrong}" />
                    <TextBlock Text="{l:T Activation.KeyHint}" Style="{StaticResource Caption}" Margin="0,4,0,10" LineHeight="18" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="KeyBox" FontFamily="{StaticResource MonoFont}" FontSize="14" AutomationProperties.Name="{l:T Activation.KeyField}"
                                     KeyDown="OnKeyBoxKeyDown" />
                        <Button Grid.Column="1" Content="{l:T Common.Cancel}" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnCancelKey" />
                        <Button Grid.Column="2" Content="{l:T Activation.KeyInstall}" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnInstallKey"
                                IsEnabled="{Binding CanInstallKey}" />
                    </Grid>
                    <TextBlock Text="{Binding KeyError}" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}" Margin="0,8,0,0"
                               Visibility="{Binding KeyError, Converter={StaticResource Presence}}" />
                </StackPanel>
            </Border>

            <ContentControl Content="{Binding Windows}" ContentTemplate="{StaticResource LicenseCardTemplate}" Margin="0,16,0,0" Focusable="False" />
            <ContentControl Content="{Binding Office}" ContentTemplate="{StaticResource LicenseCardTemplate}" Focusable="False"
                            Visibility="{Binding HasOffice, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
