<UserControl x:Class="Mesura.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <UserControl.Resources>
        <!-- A settings row: label and hint on the left, the control on the right. -->
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,28" MaxWidth="1040" HorizontalAlignment="Stretch">
            <TextBlock Text="{l:T Nav.Settings}" Style="{StaticResource PageTitle}" />

            <!-- Language -->
            <TextBlock Text="{l:T Settings.Language}" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel Margin="0,0,260,0">
                        <TextBlock Text="{l:T Settings.LanguageLabel}" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="{l:T Settings.LanguageHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource ChipTemplate}" Tag="Language" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Start-up -->
            <TextBlock Text="{l:T Settings.Startup}" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />
            <Border Style="{StaticResource Card}" Padding="20,6">
                <StackPanel>
                    <Grid Margin="0,10">
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="{l:T Settings.Elevate}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{l:T Settings.ElevateHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ElevateAtStart}" IsEnabled="{Binding CanChangeElevation}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="{l:T Settings.Elevate}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,10">
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="{l:T Settings.Tray}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{l:T Settings.TrayHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartAtSignIn}" IsEnabled="{Binding CanChangeStartup}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="{l:T Settings.Tray}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,10">
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="{l:T Settings.StartMenu}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{l:T Settings.StartMenuHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InStartMenu}" IsEnabled="{Binding CanChangeStartup}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="{l:T Settings.StartMenu}" />
                    </Grid>
                    <TextBlock Text="{Binding StartupNote}" Style="{StaticResource Caption}" Foreground="{StaticResource Warning}" Margin="0,0,0,10"
                               Visibility="{Binding StartupNote, Converter={StaticResource Presence}}" />
                </StackPanel>
            </Border>

            <!-- Folders -->
            <TextBlock Text="{l:T Settings.Folders}" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />
            <Border Style="{StaticResource Card}" Padding="20,6">
                <StackPanel>
                    <Grid Margin="0,10">
                        <StackPanel Margin="0,0,140,0">
                            <TextBlock Text="{l:T Settings.History}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding HistoryFolder}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Content="{l:T Settings.Open}" Command="{Binding OpenHistory}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,10">
                        <StackPanel Margin="0,0,260,0">
                            <TextBlock Text="{l:T Settings.Catalogs}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding CatalogsInUse}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding CatalogFolder}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{l:T Settings.CopyCatalogs}" Style="{StaticResource Ghost}" Command="{Binding CopyCatalogs}" Margin="0,0,8,0" />
                            <Button Content="{l:T Settings.Open}" Command="{Binding OpenCatalogs}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,0,0,10" Visibility="{Binding Note, Converter={StaticResource Presence}}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="{l:T Settings.About}" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />
            <Border Style="{StaticResource Card}">
                <!-- A grid, not a horizontal stack, so the text wraps at the card's width. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/mesura-mark.png" Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{Binding Version}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Runtime}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding RunningAs}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        <TextBlock Text="{l:T Settings.Privacy}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
