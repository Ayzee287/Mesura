<UserControl x:Class="Mesura.App.Pages.ConfigurationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,28" MaxWidth="1040">
            <Grid>
                <StackPanel Margin="0,0,60,0">
                    <TextBlock Text="{l:T Nav.Configurations}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Button Content="{StaticResource IconRefresh}" Style="{StaticResource IconButton}" Command="{Binding Refresh}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        AutomationProperties.Name="{l:T Common.Refresh}" ToolTip="{l:T Common.Refresh}" />
            </Grid>
            <ProgressBar Style="{StaticResource Busy}" Margin="0,14,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource Banner}" Background="{StaticResource WarningSubtle}" Margin="0,14,0,0"
                    Visibility="{Binding Blocked, Converter={StaticResource Presence}}">
                <TextBlock Text="{Binding Blocked}" Style="{StaticResource Body}" />
            </Border>

            <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Margin="0,14,0,0" Focusable="False" />

            <!-- The saved configuration: the file every app can be restored from -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="40" Height="40" Background="{StaticResource AccentSubtle}" BorderThickness="0">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconSave}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:T Config.SavedTitle}" Style="{StaticResource Tertiary}" />
                        <TextBlock Text="{Binding SavedTitle}" Style="{StaticResource BodyStrong}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SavedDetail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{l:T Config.Choose}" Style="{StaticResource Ghost}" Command="{Binding ChooseSaved}" Margin="0,0,8,0" />
                        <Button Content="{l:T Config.SaveMine}" Command="{Binding SaveMine}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{l:T Config.Apps}" Style="{StaticResource SectionTitle}" Margin="0,26,0,12" />
            <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type l:ConfigCard}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <l:AppGlyph AppId="{Binding AppId}" Label="{Binding Name}" Width="40" Height="40" Padding="6" />
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Background="{Binding StateTone, Converter={StaticResource StateBackground}}">
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource PillText}" Foreground="{Binding StateTone, Converter={StaticResource StateBrush}}" />
                                            </Border>
                                        </StackPanel>
                                        <!-- Where each source stands: a coloured dot and one line each -->
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding DefaultsTone, Converter={StaticResource StateBrush}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding DefaultsLine}" Style="{StaticResource Caption}" />
                                        </Grid>
                                        <Grid Margin="0,4,0,0" Visibility="{Binding HasSavedLine, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding SavedTone, Converter={StaticResource StateBrush}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SavedLine}" Style="{StaticResource Caption}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Foreground="{StaticResource Warning}" Margin="0,6,0,0"
                                                   Visibility="{Binding Hint, Converter={StaticResource Presence}}" />
                                    </StackPanel>
                                    <!-- The next action: only one that would change something -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="{l:T Config.UndoLast}" Style="{StaticResource Ghost}" Command="{Binding Undo}" Margin="0,0,6,0"
                                                ToolTip="{l:T Config.UndoHint}" Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{Binding RestoreLabel}" Style="{StaticResource Primary}" Command="{Binding RestoreSaved}"
                                                Visibility="{Binding ShowRestorePrimary, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{Binding DefaultsLabel}" Style="{StaticResource Primary}" Command="{Binding ApplyDefaults}"
                                                Visibility="{Binding ShowDefaultsPrimary, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="3" Style="{StaticResource ChevronToggle}" IsChecked="{Binding Expanded}" VerticalAlignment="Top" Margin="6,4,0,0"
                                                  ToolTip="{l:T Common.Details}" AutomationProperties.Name="{l:T Common.Details}" />
                                </Grid>

                                <!-- Details on demand: what each source would change, what travels, the secondary action -->
                                <StackPanel Margin="54,12,0,0" Style="{StaticResource Reveal}" Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Visibility="{Binding HasSavedChanges, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                                        <TextBlock Text="{l:T Config.SavedWouldChange}" Style="{StaticResource Tertiary}" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding SavedChanges}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='· {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasDefaultChanges, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                                        <TextBlock Text="{l:T Config.DefaultsWouldChange}" Style="{StaticResource Tertiary}" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding DefaultChanges}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='· {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding DefaultsLabel}" Command="{Binding ApplyDefaults}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Visibility="{Binding ShowDefaultsSecondary, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" LineHeight="18">
                                        <Run Text="{l:T Config.WhatTravels}" Foreground="{StaticResource TextTertiary}" /><Run Text=": " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding Included, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Caption}" LineHeight="18" Margin="0,4,0,0">
                                        <Run Text="{l:T Config.NeverCarried}" Foreground="{StaticResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Never, Mode=OneWay}" />
                                    </TextBlock>
                                    <Expander Style="{StaticResource Disclosure}" Header="{l:T Details.Technical}" Margin="0,8,0,0"
                                              Visibility="{Binding Technical, Converter={StaticResource Presence}}">
                                        <TextBlock Text="{Binding Technical}" Style="{StaticResource Mono}" />
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Apps Mesura can't configure yet, said plainly -->
            <Border Style="{StaticResource Inset}" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <l:AppGlyph AppId="sevenzip" Label="7-Zip" Width="24" Height="24" Padding="3" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{l:T Config.SevenZip}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
