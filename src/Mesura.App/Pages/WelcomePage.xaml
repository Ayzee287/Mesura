<UserControl x:Class="Mesura.App.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <UserControl.Resources>
        <!-- A door: the whole glass card is the button, lit by the pointer like every other card, ringed when the keyboard is on it. -->
        <Style x:Key="WelcomeDoor" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <l:GlowBorder x:Name="Card" Style="{StaticResource GlowCard}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </l:GlowBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentRim}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DoorContent" DataType="{x:Type l:WelcomeDoor}">
            <StackPanel>
                <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" Margin="36,56,36,24">
            <!-- Who is here and what it promises: a mark, a name, one line, three quiet facts. -->
            <Image x:Name="Mark" Width="60" Height="60" HorizontalAlignment="Left" Margin="-10,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Mesura" />
            <TextBlock Text="{l:T Welcome.Title}" Style="{StaticResource PageTitle}" FontSize="36" Margin="0,22,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{l:T Welcome.Tagline}" FontFamily="{StaticResource ExpressiveFont}" FontStyle="Italic" FontSize="22" Foreground="{StaticResource TextSecondary}"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Promises}" Margin="0,22,0,0" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Where to start: the three things most people come for. -->
            <ItemsControl ItemsSource="{Binding Doors}" Margin="-6,34,-6,0" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <l:EqualRowsPanel MinColumnWidth="250" MaxColumns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type l:WelcomeDoor}">
                        <Button Style="{StaticResource WelcomeDoor}" Command="{Binding Open}" ContentTemplate="{StaticResource DoorContent}" Content="{Binding}"
                                AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The rest of the dock, one quiet line. -->
            <TextBlock Text="{l:T Welcome.Also}" Style="{StaticResource GroupLabel}" Margin="0,28,0,6" />
            <ItemsControl ItemsSource="{Binding Others}" Focusable="False" IsTabStop="False" Margin="-10,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type l:WelcomeDoor}">
                        <Button Style="{StaticResource Ghost}" Command="{Binding Open}" Height="36" Margin="0,0,4,0" AutomationProperties.Name="{Binding Title}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
