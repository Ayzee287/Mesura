<UserControl x:Class="Mesura.App.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="36,0,36,8">
            <Grid>
                <l:PageHero Title="{l:T Nav.Apps}" Subtitle="{Binding Status}" Eyebrow="{l:T Eyebrow.Apps}" HeroMargin="0,28,320,12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,0,0">
                    <TextBox Style="{StaticResource Search}" Width="240" Tag="{l:T Apps.Search}" AutomationProperties.Name="{l:T Apps.Search}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="{StaticResource IconRefresh}" Style="{StaticResource IconButton}" Command="{Binding Refresh}" AutomationProperties.Name="{l:T Common.Refresh}"
                            ToolTip="{l:T Common.Refresh}" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
            <ProgressBar Style="{StaticResource Busy}" Margin="0,14,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource Banner}" Background="{Binding CatalogNoteTone, Converter={StaticResource StateBackground}}" Margin="0,14,0,0"
                    Visibility="{Binding CatalogNote, Converter={StaticResource Presence}}">
                <TextBlock Text="{Binding CatalogNote}" Style="{StaticResource Body}" />
            </Border>

            <Border Style="{StaticResource Banner}" Background="{StaticResource WarningSubtle}" Margin="0,14,0,0"
                    Visibility="{Binding WingetMissing, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WingetMissingText}" Style="{StaticResource Body}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{l:T Apps.GetWinget}" Command="{Binding GetWinget}" VerticalAlignment="Center"
                            Visibility="{Binding CanGetWinget, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource ChipTemplate}" Tag="AppCategory" Margin="0,18,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Margin="0,6,0,0" Focusable="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="36,4,36,20">
                <ItemsControl ItemsSource="{Binding View}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource HalfWidth}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type l:AppItem}">
                            <l:GlowBorder x:Name="Card" Style="{StaticResource GlowCard}" Padding="16,14" Margin="0,0,12,12" Cursor="Hand"
                                    MouseLeftButtonUp="OnCardClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- The app's own icon (the shared glyph: its initial where Mesura ships none). -->
                                    <l:AppGlyph AppId="{Binding Package.Id}" Label="{Binding Name}" Width="40" Height="40" Padding="6" />
                                    <StackPanel Grid.Column="1" Margin="14,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" />
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Tertiary}" Margin="8,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,3,0,0" LineHeight="17"
                                                   Visibility="{Binding Note, Converter={StaticResource Presence}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Style="{StaticResource Pill}" Background="{Binding StateTone, Converter={StaticResource StateBackground}}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource PillText}" Foreground="{Binding StateTone, Converter={StaticResource StateBrush}}" />
                                            </Border>
                                            <!-- Installed and carried by Mesura: its settings are changed on Configurations. -->
                                            <Button Style="{StaticResource Link}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                                    Command="{Binding DataContext.OpenConfigurations, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Visibility="{Binding ShowConfigureLink, Converter={StaticResource BoolToVisibility}}"
                                                    AutomationProperties.Name="{l:T Apps.OpenConfigurations}">
                                                <TextBlock Text="{l:T Apps.OpenConfigurations}" TextWrapping="Wrap" />
                                            </Button>
                                        </StackPanel>
                                        <!-- Customisations of this app (Vencord on Discord): ticked here, installed after the app. -->
                                        <ItemsControl ItemsSource="{Binding Mods}" Focusable="False" Margin="0,10,0,0"
                                                      Visibility="{Binding HasMods, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type l:AppMod}">
                                                    <Border Style="{StaticResource Inset}" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,1,10,0"
                                                                      AutomationProperties.Name="{Binding Name}" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Style="{StaticResource Body}">
                                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{StaticResource TextTertiary}" /><Run Text="{l:T Apps.Customisation}" Foreground="{StaticResource TextTertiary}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Top"
                                                                    Background="{Binding StateTone, Converter={StaticResource StateBackground}}">
                                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource PillText}" Foreground="{Binding StateTone, Converter={StaticResource StateBrush}}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top"
                                              AutomationProperties.Name="{Binding Name}" />
                                </Grid>
                            </l:GlowBorder>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanSelect}" Value="False">
                                    <Setter TargetName="Card" Property="Cursor" Value="Arrow" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:T Apps.NoMatch}" Style="{StaticResource Secondary}" Visibility="{Binding Empty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </ScrollViewer>

        <!-- Action bar: what is ticked, how it is set up afterwards, Install -->
        <Border Grid.Row="2" Style="{StaticResource ActionBar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{l:T Apps.SetUpWith}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="ConfigSource" Content="{l:T Apps.SourceDefaults}" IsChecked="{Binding ConfigureDefaults}"
                                 ToolTip="{l:T Apps.SourceDefaultsHint}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="ConfigSource" Content="{l:T Apps.SourceSaved}" IsChecked="{Binding ConfigureSaved}"
                                 IsEnabled="{Binding SavedAvailable}" ToolTip="{Binding SavedHint}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="ConfigSource" Content="{l:T Apps.SourceNone}" IsChecked="{Binding ConfigureNone}" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="{l:T Common.Cancel}" Style="{StaticResource Ghost}" Command="{Binding Cancel}" Margin="0,0,8,0"
                            Visibility="{Binding Installing, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{l:T AllSettings.Clear}" Style="{StaticResource Ghost}" Command="{Binding ClearSelection}" Margin="0,0,8,0" />
                    <Button Content="{l:T Apps.Install}" Style="{StaticResource Primary}" Command="{Binding Install}" MinWidth="120" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectionSummary}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Visibility="{Binding Installing, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Progress}" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Visibility="{Binding Installing, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
