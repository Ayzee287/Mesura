<UserControl x:Class="Mesura.App.Pages.AllSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, quick select, search; then the recommendation level -->
        <StackPanel Margin="32,26,40,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="{StaticResource IconBack}" Style="{StaticResource IconButton}" Command="{Binding Back}" AutomationProperties.Name="{l:T Nav.Optimize}"
                            ToolTip="{l:T Nav.Optimize}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{l:T AllSettings.Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ToggleButton x:Name="CollectionsButton" Style="{x:Null}" Cursor="Hand" Margin="0,0,8,0" Focusable="True"
                                  AutomationProperties.Name="{l:T AllSettings.QuickSelect}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="12,0" Height="34">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{l:T AllSettings.QuickSelect}" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconChevronDown}" FontSize="10" Margin="8,1,0,0"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=CollectionsButton}" PlacementTarget="{Binding ElementName=CollectionsButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6"
                           Closed="OnCollectionsClosed">
                        <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" CornerRadius="10"
                                Padding="6" Width="360" Margin="0,0,8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="Black" />
                            </Border.Effect>
                            <ItemsControl ItemsSource="{Binding Collections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding Select}" Style="{StaticResource Ghost}" HorizontalContentAlignment="Stretch"
                                                Padding="12,8" Click="OnCollectionChosen">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Width="260" Tag="{l:T AllSettings.Search}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T AllSettings.Search}" />
                </StackPanel>
            </Grid>

            <Grid Margin="42,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding RecommendationFilters}" ItemTemplate="{StaticResource ChipTemplate}" Tag="Recommendation" Focusable="False"
                              IsEnabled="{Binding InGuides, Converter={StaticResource Invert}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,4,0,0">
                    <TextBlock Text="{l:T AllSettings.OnlyChangeable}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OnlyChangeable}" AutomationProperties.Name="{l:T AllSettings.OnlyChangeable}" />
                </StackPanel>
            </Grid>
            <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Margin="42,8,0,0" Focusable="False" />
        </StackPanel>

        <!-- Categories, list and details -->
        <Grid Grid.Row="1" Margin="32,6,32,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="3*" MinWidth="320" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" MinWidth="250" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- The category rail: an impact each, the guides apart; a mint count where something can be applied here. -->
            <StackPanel>
                <TextBlock Text="{l:T AllSettings.Categories}" Style="{StaticResource GroupLabel}" Margin="12,8,0,8" />
                <ItemsControl ItemsSource="{Binding Rail}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type l:RailChoice}">
                            <RadioButton Style="{StaticResource RailItem}" GroupName="AllSettingsRail" IsChecked="{Binding IsSelected}"
                                         AutomationProperties.Name="{Binding Label}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{StaticResource AccentSubtle}" Padding="7,1,7,2"
                                            Visibility="{Binding Available, Converter={StaticResource Presence}}" ToolTip="{l:T AllSettings.AvailableHint}">
                                        <TextBlock Text="{Binding Available}" Style="{StaticResource PillText}" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Tertiary}" VerticalAlignment="Center"
                                               Visibility="{Binding Available, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="10,6,0,4">
                    <TextBlock Text="{Binding RailTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding RailSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource SelectableList}" ItemContainerStyle="{StaticResource SelectableItem}"
                         ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         KeyDown="OnListKeyDown">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GroupLabel}" Margin="10,14,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type l:SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,12,0"
                                          AutomationProperties.Name="{Binding Name}"
                                          Visibility="{Binding Operation.Applicable, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                    <!-- The risk, where it isn't low, leads the second line; the summary takes the rest of it. -->
                                    <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource Tag}" Margin="0,0,8,0" Padding="6,0,6,1"
                                                Background="{Binding RiskTone, Converter={StaticResource StateBackground}}"
                                                Visibility="{Binding ShowRisk, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding RiskWhy}">
                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource TagText}" FontSize="11" Foreground="{Binding RiskTone, Converter={StaticResource StateBrush}}" />
                                        </Border>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="10,1,0,0"
                                        Background="{Binding StateTone, Converter={StaticResource StateBackground}}">
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource PillText}" Foreground="{Binding StateTone, Converter={StaticResource StateBrush}}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{l:T AllSettings.NoMatch}" Style="{StaticResource Secondary}" Margin="10,20,0,0"
                           Visibility="{Binding Empty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Details -->
            <Border Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="20,18">
                <Grid>
                    <TextBlock Text="{l:T AllSettings.SelectHint}" Style="{StaticResource Secondary}"
                               Visibility="{Binding HasSelection, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRow.Category}" Style="{StaticResource Tertiary}" />
                            <TextBlock Text="{Binding SelectedRow.Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedRow.Summary}" Style="{StaticResource Secondary}" Margin="0,6,0,14" Foreground="{StaticResource Text}" />
                            <ContentControl Content="{Binding SelectedRow}" ContentTemplate="{StaticResource SettingDetails}" Focusable="False" />
                            <Button Content="{Binding SelectedRow.OpenLabel}" Command="{Binding OpenTarget}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Visibility="{Binding SelectedRow.OpenTarget, Converter={StaticResource Presence}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
            <Grid Margin="40,12,40,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="24,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ProgressBar Style="{StaticResource Busy}" Width="80" Margin="0,0,14,0" VerticalAlignment="Center"
                                 Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{l:T AllSettings.Clear}" Style="{StaticResource Ghost}" Command="{Binding Clear}" Margin="0,0,8,0" />
                    <Button Content="{l:T AllSettings.Apply}" Style="{StaticResource Primary}" Command="{Binding Apply}" MinWidth="120" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
