<UserControl x:Class="Mesura.App.Pages.AllSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <UserControl.Resources>
        <!-- The page's actions, shown in the command dock (MainWindow) while the page is open: the summary, then what can be done. -->
        <DataTemplate x:Key="DockActions">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SelectionSummary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <ProgressBar Style="{StaticResource Busy}" Width="80" Margin="0,0,14,0" VerticalAlignment="Center"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{l:T AllSettings.Clear}" Style="{StaticResource Ghost}" Command="{Binding Clear}" Margin="0,0,8,0" />
                <Button Content="{l:T AllSettings.Apply}" Style="{StaticResource Primary}" Command="{Binding Apply}" MinWidth="120" />
            </StackPanel>
        </Grid>

        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: the title with quick select and search, then the recommendation level -->
        <StackPanel>
            <Grid>
                <l:PageHero Title="{l:T AllSettings.Title}" Subtitle="{Binding CountText}" HeroMargin="36,28,440,12" />
                <!-- The actions sit over the hero's right edge (they are named, which a hero's own content can't be). -->
                <Grid Margin="0,0,36,12" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="CollectionsButton" Style="{x:Null}" Cursor="Hand" Margin="0,0,8,0" Focusable="True"
                                  AutomationProperties.Name="{l:T AllSettings.QuickSelect}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <!-- Quick select is the fastest way to a sensible set, so it is drawn as a control: a filled pill with an accent edge and the sparkle mark. -->
                                <Border x:Name="B" Background="{StaticResource Raised}" BorderBrush="{StaticResource AccentRim}" BorderThickness="1" CornerRadius="17" Padding="14,0" Height="34">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconOptimize}" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource Accent}" />
                                        <TextBlock Text="{l:T AllSettings.QuickSelect}" Foreground="{StaticResource Text}" FontWeight="Medium" />
                                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconChevronDown}" FontSize="10" Margin="8,1,0,0"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="{StaticResource Hover}" />
                                        <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="{StaticResource Hover}" />
                                        <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=CollectionsButton}" PlacementTarget="{Binding ElementName=CollectionsButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6"
                           Closed="OnCollectionsClosed">
                        <Border Background="{StaticResource Popover}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="14"
                                Padding="6" Width="360" Margin="0,0,8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="Black" />
                            </Border.Effect>
                            <ItemsControl ItemsSource="{Binding Collections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding Select}" Style="{StaticResource Ghost}" HorizontalContentAlignment="Stretch"
                                                Padding="12,8" Click="OnCollectionChosen">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Width="260" Tag="{l:T AllSettings.Search}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T AllSettings.Search}" />
                </StackPanel>
                            </Grid>
            </Grid>

            <Grid Margin="36,0,36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding RecommendationFilters}" ItemTemplate="{StaticResource ChipTemplate}" Tag="Recommendation" Focusable="False"
                              IsEnabled="{Binding InGuides, Converter={StaticResource Invert}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,4,0,0">
                    <TextBlock Text="{l:T AllSettings.OnlyChangeable}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OnlyChangeable}" AutomationProperties.Name="{l:T AllSettings.OnlyChangeable}" />
                </StackPanel>
            </Grid>
            <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Margin="36,8,36,0" Focusable="False" />
        </StackPanel>

        <!-- Categories, the cards, and the details drawer over the cards' right edge -->
        <Grid Grid.Row="1" Margin="36,8,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- The category rail: an impact each, the guides apart; a mint count where something can be applied here. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="{l:T AllSettings.Categories}" Style="{StaticResource GroupLabel}" Margin="12,8,0,8" />
                    <ItemsControl ItemsSource="{Binding Rail}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type l:RailChoice}">
                                <RadioButton Style="{StaticResource RailItem}" GroupName="AllSettingsRail" IsChecked="{Binding IsSelected}"
                                             AutomationProperties.Name="{Binding Label}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{StaticResource AccentSubtle}" Padding="7,1,7,2"
                                                Visibility="{Binding Available, Converter={StaticResource Presence}}" ToolTip="{l:T AllSettings.AvailableHint}">
                                            <TextBlock Text="{Binding Available}" Style="{StaticResource PillText}" Foreground="{StaticResource Accent}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Tertiary}" VerticalAlignment="Center"
                                                   Visibility="{Binding Available, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="2,6,0,6">
                    <TextBlock Text="{Binding RailTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding RailSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource SelectableList}" ItemContainerStyle="{StaticResource CardItem}" ItemTemplate="{StaticResource TweakCard}"
                         ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         KeyDown="OnListKeyDown">
                    <!-- With grouping, the list's own panel lays out the cards inside each group. -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource FlatGroupItem}">
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GroupLabel}" Margin="2,12,0,8" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                </ListBox>
                <TextBlock Grid.Row="1" Text="{l:T AllSettings.NoMatch}" Style="{StaticResource Secondary}" Margin="2,20,0,0"
                           Visibility="{Binding Empty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Details: a drawer over the cards' right edge while a setting is selected -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource Popover}" Width="400"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,0,0" Padding="22,18,14,18"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{Binding SelectedRow.Category}" Style="{StaticResource Tertiary}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" HorizontalAlignment="Right" Width="30" Height="30"
                                Click="OnCloseDetails" ToolTip="{l:T Common.Close}" AutomationProperties.Name="{l:T Common.Close}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRow.Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedRow.Summary}" Style="{StaticResource Secondary}" Margin="0,6,0,14" Foreground="{StaticResource Text}" />
                            <ContentControl Content="{Binding SelectedRow}" ContentTemplate="{StaticResource SettingDetails}" Focusable="False" />
                            <Button Content="{Binding SelectedRow.OpenLabel}" Command="{Binding OpenTarget}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Visibility="{Binding SelectedRow.OpenTarget, Converter={StaticResource Presence}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
