<UserControl x:Class="Mesura.App.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <UserControl.Resources>
        <!-- A row of app icons (a profile's apps), wrapping. -->
        <DataTemplate x:Key="AppChipsTemplate">
            <ItemsControl ItemsSource="{Binding}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type l:PlanAppChip}">
                        <l:AppGlyph AppId="{Binding Id}" Label="{Binding Name}" Width="26" Height="26" Padding="3" Margin="0,0,6,6" ToolTip="{Binding Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- One part of what a profile holds: an icon, a name, one line. -->
        <Style x:Key="HoldsTile" TargetType="Border" BasedOn="{StaticResource Inset}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,0,36,28">
            <l:PageHero Title="{l:T Nav.Profiles}" Subtitle="{l:T Profiles.Subtitle}" HeroMargin="0,28,0,12" />

            <Border Style="{StaticResource Banner}" Background="{StaticResource DangerSubtle}" Margin="0,14,0,0"
                    Visibility="{Binding Unavailable, Converter={StaticResource Presence}}">
                <TextBlock Text="{Binding Unavailable}" Style="{StaticResource Body}" />
            </Border>
            <Border Style="{StaticResource Banner}" Background="{StaticResource WarningSubtle}" Margin="0,14,0,0"
                    Visibility="{Binding ProfileNote, Converter={StaticResource Presence}}">
                <TextBlock Text="{Binding ProfileNote}" Style="{StaticResource Body}" />
            </Border>

            <!-- Two distinct actions -->
            <UniformGrid Columns="2" Margin="0,20,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40" Background="{StaticResource AccentSubtle}" BorderThickness="0">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconSave}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{l:T Profiles.SaveTitle}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{l:T Profiles.SaveText}" Style="{StaticResource Secondary}" Margin="0,4,0,12" />
                            <Button Content="{l:T Profiles.Save}" Command="{Binding Save}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40" Background="{StaticResource AccentSubtle}" BorderThickness="0">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconRun}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{l:T Profiles.RestoreTitle}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{l:T Profiles.RestoreText}" Style="{StaticResource Secondary}" Margin="0,4,0,12" />
                            <Button Content="{l:T Profiles.Open}" Command="{Binding Open}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- What a profile holds -->
            <TextBlock Text="{l:T Profiles.Contains}" Style="{StaticResource GroupLabel}" Margin="2,18,0,8" />
            <UniformGrid Columns="4" Margin="0,0,-10,0">
                <Border Style="{StaticResource HoldsTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconApps}" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" />
                        <TextBlock Text="{l:T Profiles.ContainsApps}" Style="{StaticResource BodyStrong}" Margin="0,8,0,2" />
                        <TextBlock Text="{l:T Profiles.ContainsAppsText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HoldsTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconConfigurations}" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" />
                        <TextBlock Text="{l:T Profiles.ContainsSettings}" Style="{StaticResource BodyStrong}" Margin="0,8,0,2" />
                        <TextBlock Text="{l:T Profiles.ContainsSettingsText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HoldsTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconWindows}" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" />
                        <TextBlock Text="{l:T Profiles.ContainsWindows}" Style="{StaticResource BodyStrong}" Margin="0,8,0,2" />
                        <TextBlock Text="{l:T Profiles.ContainsWindowsText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HoldsTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconGpu}" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" />
                        <TextBlock Text="{l:T Profiles.ContainsNvidia}" Style="{StaticResource BodyStrong}" Margin="0,8,0,2" />
                        <TextBlock Text="{l:T Profiles.ContainsNvidiaText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Margin="0,16,0,0" Visibility="{Binding Progress, Converter={StaticResource Presence}}">
                <ProgressBar Style="{StaticResource Busy}" />
                <TextBlock Text="{Binding Progress}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>

            <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Margin="0,16,0,0" Focusable="False" />

            <!-- Save: what the profile will hold, before it is written -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18" BorderBrush="{StaticResource StrokeStrong}"
                    Visibility="{Binding HasPendingSave, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Style="{StaticResource Reveal}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:T Profiles.ReadyToSave}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{l:T Profiles.ReadyToSaveText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="{l:T Common.Cancel}" Style="{StaticResource Ghost}" Command="{Binding CancelSave}" Margin="0,0,8,0" />
                            <Button Content="{l:T Profiles.SaveAs}" Style="{StaticResource Primary}" Command="{Binding ConfirmSave}" />
                        </StackPanel>
                    </Grid>
                    <ContentControl Content="{Binding PendingApps}" ContentTemplate="{StaticResource AppChipsTemplate}" Margin="0,14,0,4" Focusable="False"
                                    Visibility="{Binding HasPendingApps, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding PendingLines}" ItemTemplate="{StaticResource StepLineTemplate}" Margin="0,6,0,0" Focusable="False" />
                </StackPanel>
            </Border>

            <!-- The opened profile -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18" Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding ProfileName}" Style="{StaticResource SectionTitle}" FontSize="18" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProfileDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ProfileContents}" Style="{StaticResource Caption}" Margin="0,2,0,0" Foreground="{StaticResource Text}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="{l:T Common.Cancel}" Style="{StaticResource Ghost}" Command="{Binding Cancel}" Margin="0,0,8,0"
                                    Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{l:T Common.Close}" Style="{StaticResource Ghost}" Command="{Binding Close}" Margin="0,0,8,0" />
                            <Button Content="{Binding RunLabel}" Style="{StaticResource Primary}" Command="{Binding Run}" MinWidth="120" />
                        </StackPanel>
                    </Grid>
                    <ContentControl Content="{Binding ProfileApps}" ContentTemplate="{StaticResource AppChipsTemplate}" Margin="0,12,0,0" Focusable="False" />
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type l:ProfileStep}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top" Margin="0,6,14,0"
                                            Background="{Binding Tone, Converter={StaticResource StateBackground}}">
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Tone, Converter={StaticResource StateBrush}}" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Row}" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource StepLineTemplate}" Margin="0,10,0,0" Focusable="False"
                                                          Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                    <ToggleButton Grid.Column="2" Style="{StaticResource ChevronToggle}" IsChecked="{Binding Expanded}" VerticalAlignment="Top" Margin="6,8,0,0"
                                                  Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:T Common.Details}" AutomationProperties.Name="{l:T Common.Details}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Profiles saved or opened here -->
            <TextBlock Text="{l:T Profiles.Recent}" Style="{StaticResource SectionTitle}" Margin="0,26,0,12" />
            <Border Style="{StaticResource Inset}" Visibility="{Binding HasRecent, Converter={StaticResource Presence}, ConverterParameter=invert}">
                <TextBlock Text="{l:T Profiles.RecentEmpty}" Style="{StaticResource Caption}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type l:RecentProfileItem}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Tertiary}" VerticalAlignment="Center" Margin="10,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Contents}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    <ContentControl Content="{Binding Apps}" ContentTemplate="{StaticResource AppChipsTemplate}" Margin="0,8,0,0" Focusable="False"
                                                    Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Tertiary}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Border Style="{StaticResource Pill}" Background="{Binding StatusTone, Converter={StaticResource StateBackground}}" Margin="0,0,10,0"
                                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource PillText}" Foreground="{Binding StatusTone, Converter={StaticResource StateBrush}}" />
                                    </Border>
                                    <Button Content="{l:T Profiles.OpenRecent}" Command="{Binding Open}"
                                            Visibility="{Binding Exists, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
