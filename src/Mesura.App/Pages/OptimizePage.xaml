<UserControl x:Class="Mesura.App.Pages.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <UserControl.Resources>
        <!-- The page's actions, shown in the command dock (MainWindow) while the page is open: the summary, then what can be done. -->
        <DataTemplate x:Key="DockActions">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SelectionSummary}"
                       Visibility="{Binding Running, Converter={StaticResource Presence}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding Progress}" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <ProgressBar Style="{StaticResource Busy}" Width="80" Margin="0,0,14,0" VerticalAlignment="Center"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{l:T Common.Cancel}" Style="{StaticResource Ghost}" Command="{Binding Cancel}" Margin="0,0,8,0"
                        Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{l:T Setup.Review}" Style="{StaticResource Primary}" Command="{Binding Apply}" MinWidth="140" />
            </StackPanel>
        </Grid>

        </DataTemplate>
        <!-- The head of a plan card: icon, title, one line, a count, the run state, a switch and the chevron. -->
        <DataTemplate x:Key="SectionHead" DataType="{x:Type l:PlanSection}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" />
                    <TextBlock Text="{Binding Line}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip="{Binding Line}" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="0,0,10,0" Background="{Binding RunTone, Converter={StaticResource StateBackground}}"
                        Visibility="{Binding RunState, Converter={StaticResource Presence}}">
                    <TextBlock Text="{Binding RunState}" Style="{StaticResource PillText}" Foreground="{Binding RunTone, Converter={StaticResource StateBrush}}" />
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Pill}" Margin="0,0,12,0" Background="{StaticResource NeutralSubtle}"
                        Visibility="{Binding Badge, Converter={StaticResource Presence}}">
                    <TextBlock Text="{Binding Badge}" Style="{StaticResource PillText}" Foreground="{StaticResource Text}" />
                </Border>
                <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding Included}" Margin="0,0,10,0"
                          Visibility="{Binding Available, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.Name="{Binding Title}" ToolTip="{l:T Setup.SectionSwitch}" />
                <ToggleButton Grid.Column="5" Style="{StaticResource ChevronToggle}" IsChecked="{Binding Expanded}"
                              ToolTip="{l:T Common.Details}" AutomationProperties.Name="{l:T Common.Details}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,0,36,24">
                <!-- Header -->
                <Grid>
                    <l:PageHero Title="{l:T Setup.Title}" Subtitle="{Binding Status}" Expressive="True" HeroMargin="0,28,200,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,0,0">
                        <Button Style="{StaticResource Ghost}" Command="{Binding OpenAllSettings}" AutomationProperties.Name="{l:T Optimize.AllSettings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:T Optimize.AllSettings}" />
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconChevronRight}" FontSize="10" Margin="8,1,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Content="{StaticResource IconRefresh}" Style="{StaticResource IconButton}" Command="{Binding Refresh}" AutomationProperties.Name="{l:T Common.Refresh}"
                                ToolTip="{l:T Common.Refresh}" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>

                <ProgressBar Style="{StaticResource Busy}" Margin="0,14,0,0" Visibility="{Binding Checking, Converter={StaticResource BoolToVisibility}}" />

                <!-- What Mesura sees -->
                <ItemsControl ItemsSource="{Binding Facts}" Margin="0,16,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Tone, Converter={StaticResource StateBackground}}" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Margin="0,0,8,0"
                                               Foreground="{Binding Tone, Converter={StaticResource StateBrush}}" />
                                    <TextBlock Text="{Binding Text}" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- An edited catalog in use, or an old one set aside: said where the work starts, not only in Settings. -->
                <Border Style="{StaticResource Banner}" Background="{Binding CatalogNoteTone, Converter={StaticResource StateBackground}}" Margin="0,4,0,8"
                        Visibility="{Binding CatalogNote, Converter={StaticResource Presence}}">
                    <TextBlock Text="{Binding CatalogNote}" Style="{StaticResource Body}" />
                </Border>

                <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Margin="0,4,0,0" Focusable="False" />

                <!-- An unfinished setup comes first: what is done, what is next, and the way on. -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource Reveal}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconResume}" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingTitle}" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="{Binding PendingNext}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{l:T Setup.Discard}" Style="{StaticResource Ghost}" Command="{Binding DiscardSetup}" Margin="0,0,8,0" />
                                <Button Content="{l:T Setup.Continue}" Style="{StaticResource Primary}" Command="{Binding ContinueSetup}" MinWidth="110"
                                        Visibility="{Binding WaitingForDriver, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PendingSteps}" Margin="50,12,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Tag}" Margin="0,0,6,6" Background="{Binding Tone, Converter={StaticResource StateBackground}}">
                                        <TextBlock Style="{StaticResource TagText}">
                                            <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" Foreground="{Binding Tone, Converter={StaticResource StateBrush}}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The driver step: the user's turn in NVCleanstall, with the checklist beside it. -->
                        <Border Style="{StaticResource Inset}" Margin="50,8,0,0" Padding="16,14"
                                Visibility="{Binding WaitingForDriver, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{l:T Setup.WaitingTitle}" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="{Binding WaitingTarget}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <TextBlock Text="{l:T Setup.WaitingSteps}" Style="{StaticResource Caption}" Margin="0,10,0,6" LineHeight="18" />
                                <ItemsControl ItemsSource="{Binding WaitingChecklist}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:T Setup.WaitingTweaksTitle}" Style="{StaticResource Caption}" Margin="0,10,0,6" LineHeight="18" />
                                <ItemsControl ItemsSource="{Binding WaitingTweaks}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding WaitingInterrupt}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconRefresh}" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding WaitingWatch}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{l:T Setup.WaitingSkipNote}" Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="18" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="{l:T Setup.DriverFinished}" Style="{StaticResource Primary}" Command="{Binding DriverFinished}" Margin="0,0,8,0" />
                                    <Button Command="{Binding ReopenNvCleanstall}" Margin="0,0,8,0" AutomationProperties.Name="{l:T Setup.ReopenNvCleanstall}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconExternal}" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="{l:T Setup.ReopenNvCleanstall}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{l:T Setup.SkipDriver}" Style="{StaticResource Ghost}" Command="{Binding SkipDriver}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- The outcome -->
                <TextBlock Text="{l:T Optimize.ChooseOutcome}" Style="{StaticResource SectionTitle}" Margin="0,20,0,12"
                           Visibility="{Binding HasOutcomes, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Outcomes}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Outcome" IsChecked="{Binding IsSelected}" Margin="0,0,12,0"
                                         AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Summary}">
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" Margin="0,6,0,12" MinHeight="38" />
                                    <Border Style="{StaticResource Pill}" Background="{Binding PendingTone, Converter={StaticResource StateBackground}}"
                                            Visibility="{Binding PendingText, Converter={StaticResource Presence}}">
                                        <TextBlock Text="{Binding PendingText}" Style="{StaticResource PillText}"
                                                   Foreground="{Binding PendingTone, Converter={StaticResource StateBrush}}" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The plan: one card per step -->
                <TextBlock Text="{l:T Setup.PlanTitle}" Style="{StaticResource SectionTitle}" Margin="0,28,0,12" />

                <!-- Windows settings -->
                <l:GlowBorder Style="{StaticResource PlanGlow}" DataContext="{Binding Windows}">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" Focusable="False" />
                        <StackPanel Style="{StaticResource Reveal}" Margin="50,12,0,0" Visibility="{Binding Windows.Expanded, Converter={StaticResource BoolToVisibility}}"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="{Binding PlanHeader}" Style="{StaticResource GroupLabel}" Margin="0,0,0,4"
                                       Visibility="{Binding PlanEmpty, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                            <Border Style="{StaticResource Inset}" Margin="0,4,0,8" Visibility="{Binding PlanEmpty, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconDone}" Foreground="{StaticResource Success}" Margin="0,0,10,0" />
                                    <TextBlock Text="{l:T Optimize.NothingToChange}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource PlanItemTemplate}" Focusable="False" />
                            <StackPanel Visibility="{Binding HasExtras, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                <TextBlock Text="{l:T Optimize.Extras}" Style="{StaticResource GroupLabel}" Margin="0,8,0,2" />
                                <TextBlock Text="{l:T Optimize.ExtrasHint}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Extras}" ItemTemplate="{StaticResource PlanItemTemplate}" Focusable="False" />
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,12,0,6" Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibility}}" />
                            <Expander Style="{StaticResource Disclosure}" Header="{Binding DoneHeader}" Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Done}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="11" Foreground="{StaticResource Success}" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Style="{StaticResource Disclosure}" Header="{Binding NotHereHeader}" Visibility="{Binding HasNotHere, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding NotHere}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,3">
                                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text=" · " /><Run Text="{Binding ShortReason, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </l:GlowBorder>

                <!-- Apps -->
                <l:GlowBorder Style="{StaticResource PlanGlow}" DataContext="{Binding AppsSection}">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" Focusable="False" />
                        <StackPanel Style="{StaticResource Reveal}" Margin="50,12,0,0" Visibility="{Binding AppsSection.Expanded, Converter={StaticResource BoolToVisibility}}"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl ItemsSource="{Binding PlanApps}" Focusable="False" Visibility="{Binding HasPlanApps, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type l:PlanAppChip}">
                                        <Border Style="{StaticResource Inset}" Padding="8,6" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <l:AppGlyph AppId="{Binding Id}" Label="{Binding Name}" Width="24" Height="24" Padding="3" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding AppsSourceLine}" Style="{StaticResource Caption}" Margin="0,0,0,6" Visibility="{Binding HasPlanApps, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{l:T Setup.AppsHint}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <Button Style="{StaticResource Link}" HorizontalAlignment="Left" Command="{Binding OpenApps}" AutomationProperties.Name="{l:T Setup.ChooseApps}">
                                <TextBlock Text="{l:T Setup.ChooseApps}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </l:GlowBorder>

                <!-- Visual C++ runtimes -->
                <l:GlowBorder Style="{StaticResource PlanGlow}" DataContext="{Binding Runtimes}"
                              Visibility="{Binding DataContext.ShowRuntimes, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" Focusable="False" />
                        <StackPanel Style="{StaticResource Reveal}" Margin="50,12,0,0" Visibility="{Binding Runtimes.Expanded, Converter={StaticResource BoolToVisibility}}"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="{l:T Setup.RuntimesHint}" Style="{StaticResource Caption}" Margin="0,0,0,10" LineHeight="18" />
                            <ItemsControl ItemsSource="{Binding RuntimeRows}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource HalfWidth}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type l:RuntimeRow}">
                                        <Border Style="{StaticResource Row}" Margin="0,0,8,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Included}" IsEnabled="{Binding CanInclude}" Margin="0,1,10,0" VerticalAlignment="Top"
                                                          AutomationProperties.Name="{Binding Name}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Tertiary}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{Binding StateTone, Converter={StaticResource StateBackground}}" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource PillText}" Foreground="{Binding StateTone, Converter={StaticResource StateBrush}}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </l:GlowBorder>

                <!-- NVIDIA driver and profiles -->
                <l:GlowBorder Style="{StaticResource PlanGlow}" DataContext="{Binding Nvidia}"
                              Visibility="{Binding DataContext.HasNvidia, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" Focusable="False" />
                        <StackPanel Style="{StaticResource Reveal}" Margin="50,12,0,0" Visibility="{Binding Nvidia.Expanded, Converter={StaticResource BoolToVisibility}}"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="{l:T Setup.NoNvidiaHint}" Style="{StaticResource Caption}"
                                       Visibility="{Binding HasNvidia, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                            <StackPanel Visibility="{Binding HasNvidia, Converter={StaticResource BoolToVisibility}}">
                                <!-- Driver -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:T Setup.DriverInstalled}" Style="{StaticResource Tertiary}" />
                                        <TextBlock Text="{Binding NvidiaInstalled}" Style="{StaticResource BodyStrong}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{l:T Setup.DriverLatest}" Style="{StaticResource Tertiary}" />
                                        <TextBlock Text="{Binding NvidiaLatest}" Style="{StaticResource BodyStrong}" />
                                        <Button Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,2,0,0" FontSize="12" Command="{Binding OpenDriverPage}"
                                                AutomationProperties.Name="{l:T Setup.DriverNotes}">
                                            <TextBlock Text="{l:T Setup.DriverNotes}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{l:T Setup.DriverHow}" Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="18" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                    <Run Text="NVCleanstall · " Foreground="{StaticResource Text}" /><Run Text="{Binding NvCleanstallState, Mode=OneWay}" />
                                </TextBlock>

                                <!-- Components -->
                                <Grid Margin="0,14,0,6">
                                    <TextBlock Style="{StaticResource GroupLabel}" Margin="0">
                                        <Run Text="{l:T Setup.Components}" /><Run Text=" · " /><Run Text="{Binding ComponentsName, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Style="{StaticResource Link}" HorizontalAlignment="Right" FontSize="12" Command="{Binding ResetComponents}"
                                            AutomationProperties.Name="{l:T Setup.ComponentsReset}">
                                        <TextBlock Text="{l:T Setup.ComponentsReset}" />
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Components}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource HalfWidth}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type l:ComponentRow}">
                                            <Border Style="{StaticResource Row}" Margin="0,0,8,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Included}" IsEnabled="{Binding CanChange}" Margin="0,1,10,0" VerticalAlignment="Top"
                                                              AutomationProperties.Name="{Binding Name}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                                        <TextBlock Text="{Binding Rule}" Style="{StaticResource Caption}" LineHeight="17"
                                                                   Visibility="{Binding Rule, Converter={StaticResource Presence}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- NVCleanstall's tweaks (Show Expert Tweaks on) -->
                                <TextBlock Text="{l:T Setup.Tweaks}" Style="{StaticResource GroupLabel}" Margin="0,14,0,6" />
                                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource HalfWidth}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type l:TweakRow}">
                                            <Border Style="{StaticResource Row}" Margin="0,0,8,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Included}" Margin="0,1,10,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                                        <TextBlock Text="{Binding Rule}" Style="{StaticResource Caption}" LineHeight="17"
                                                                   Visibility="{Binding Rule, Converter={StaticResource Presence}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding InterruptLine}" Style="{StaticResource Caption}" Margin="10,6,0,0" />
                                <TextBlock Text="{l:T Setup.TweaksScope}" Style="{StaticResource Caption}" Margin="10,4,0,0" LineHeight="18" />

                                <!-- The NVIDIA profile, imported after the driver -->
                                <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconArchive}" FontSize="14" Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource BodyStrong}">
                                            <Run Text="{l:T Setup.ProfileTitle}" /><Run Text=" · " /><Run Text="{Binding ProfileName, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{l:T Setup.ProfileHow}" Style="{StaticResource Caption}" Margin="0,3,0,0" LineHeight="18" />
                                        <TextBlock Text="{Binding ProfileSource}" Style="{StaticResource Tertiary}" Margin="0,4,0,0"
                                                   Visibility="{Binding ProfileSource, Converter={StaticResource Presence}}" />
                                        <!-- How the file is fitted to this PC's GPU (D032): the original stays unchanged. -->
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasProfileFit, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding ProfileFit}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,1" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{l:T Setup.ProfileFitWhy}" Style="{StaticResource Caption}" Margin="0,3,0,0" LineHeight="18" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                            <Run Text="NVIDIA Profile Inspector · " Foreground="{StaticResource Text}" /><Run Text="{Binding InspectorState, Mode=OneWay}" />
                                        </TextBlock>
                                        <Expander Style="{StaticResource Disclosure}" Header="{l:T Setup.ProfileSettings}" Margin="0,6,0,0"
                                                  Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding ProfileSettings}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Grid>

                                <!-- Guides -->
                                <ItemsControl ItemsSource="{Binding NvidiaGuides}" Focusable="False" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Row}" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconGuide}" FontSize="14" Foreground="{StaticResource TextTertiary}"
                                                               VerticalAlignment="Top" Margin="0,2,14,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Row.Name}" Style="{StaticResource Body}" />
                                                        <TextBlock Text="{Binding Row.Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                        <ContentControl Content="{Binding Row}" ContentTemplate="{StaticResource SettingDetails}" Margin="0,12,0,4" Focusable="False"
                                                                        Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="{l:T Details.OpenGuide}" Style="{StaticResource Ghost}" Command="{Binding Open}"
                                                            VerticalAlignment="Top" Margin="8,-4,2,0" />
                                                    <ToggleButton Grid.Column="3" Style="{StaticResource ChevronToggle}" IsChecked="{Binding Expanded}" VerticalAlignment="Top"
                                                                  ToolTip="{l:T Common.Details}" AutomationProperties.Name="{l:T Common.Details}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </l:GlowBorder>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
