<UserControl x:Class="Mesura.App.Pages.SystemInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <UserControl.Resources>
        <!-- A label and its value. A value that couldn't be read says so, dimmed. -->
        <DataTemplate x:Key="InfoRowTemplate" DataType="{x:Type l:InfoRow}">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Tertiary}" FontSize="12.5" Margin="0,1,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}" FontSize="13" LineHeight="18" TextWrapping="Wrap" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource TextTertiary}" />
                    <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A measured share: a label and its caption, then the bar. -->
        <DataTemplate x:Key="InfoBarTemplate" DataType="{x:Type l:InfoBar}">
            <StackPanel Margin="0,2,0,10">
                <Grid>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" FontSize="13" />
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Style="{StaticResource Meter}" Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Margin="0,6,0,0"
                             Foreground="{Binding Tone, Converter={StaticResource StateBrush}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="InfoGroupTemplate" DataType="{x:Type l:InfoGroup}">
            <StackPanel Margin="0,0,0,6">
                <Grid Margin="0,2,0,8" Visibility="{Binding HasHeading, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Heading}" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{StaticResource NeutralSubtle}" Margin="10,0,0,0"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Badge}" Style="{StaticResource PillText}" Foreground="{StaticResource TextSecondary}" />
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource InfoRowTemplate}" Focusable="False" />
                <ItemsControl ItemsSource="{Binding Bars}" ItemTemplate="{StaticResource InfoBarTemplate}" Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="InfoCardTemplate" DataType="{x:Type l:InfoCard}">
            <Border Style="{StaticResource Card}" Padding="20,18,20,12" Margin="0,0,14,14" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource IconTile}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource AccentHover}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource InfoGroupTemplate}" Focusable="False" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The four things most people want first, large. -->
        <DataTemplate x:Key="HighlightTemplate" DataType="{x:Type l:Highlight}">
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,14,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{StaticResource AccentHover}" Margin="0,1,9,0" />
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Tertiary}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Caption}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,0,36,28">
            <Grid>
                <l:PageHero Title="{l:T System.Title}" Subtitle="{Binding Status}" Eyebrow="{l:T Eyebrow.System}" HeroMargin="0,28,420,12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,0,0">
                    <Button Command="{Binding Copy}" Style="{StaticResource Ghost}" AutomationProperties.Name="{l:T System.Copy}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconCopy}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T System.Copy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Save}" Style="{StaticResource Ghost}" Margin="2,0,0,0" AutomationProperties.Name="{l:T System.Save}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconExport}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T System.Save}" />
                        </StackPanel>
                    </Button>
                    <Button Content="{StaticResource IconRefresh}" Style="{StaticResource IconButton}" Command="{Binding Refresh}" Margin="4,0,0,0"
                            AutomationProperties.Name="{l:T Common.Refresh}" ToolTip="{l:T Common.Refresh}" />
                </StackPanel>
            </Grid>

            <ProgressBar Style="{StaticResource Busy}" Margin="0,6,0,10" Visibility="{Binding Loading, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Margin="0,0,0,12" Focusable="False" />

            <TextBlock Text="{l:T System.Reading}" Style="{StaticResource Secondary}" Margin="2,8,0,0" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

            <UniformGrid Columns="4" Margin="0,0,-14,14" HorizontalAlignment="Stretch" Visibility="{Binding HasHighlights, Converter={StaticResource BoolToVisibility}}">
                <ContentPresenter Content="{Binding Highlights[0]}" ContentTemplate="{StaticResource HighlightTemplate}" />
                <ContentPresenter Content="{Binding Highlights[1]}" ContentTemplate="{StaticResource HighlightTemplate}" />
                <ContentPresenter Content="{Binding Highlights[2]}" ContentTemplate="{StaticResource HighlightTemplate}" />
                <ContentPresenter Content="{Binding Highlights[3]}" ContentTemplate="{StaticResource HighlightTemplate}" />
            </UniformGrid>

            <UniformGrid Columns="2" Margin="0,0,-14,0">
                <ItemsControl ItemsSource="{Binding LeftCards}" ItemTemplate="{StaticResource InfoCardTemplate}" Focusable="False" />
                <ItemsControl ItemsSource="{Binding RightCards}" ItemTemplate="{StaticResource InfoCardTemplate}" Focusable="False" />
            </UniformGrid>

            <TextBlock Text="{l:T System.Footer}" Style="{StaticResource Tertiary}" Margin="2,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
