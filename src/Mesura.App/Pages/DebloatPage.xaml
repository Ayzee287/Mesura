<UserControl x:Class="Mesura.App.Pages.DebloatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mesura.App">
    <UserControl.Resources>
        <!-- The page's actions, shown in the command dock (MainWindow) while the page is open: the summary, then what can be done. -->
        <DataTemplate x:Key="DockActions">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SelectionSummary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <ProgressBar Style="{StaticResource Busy}" Width="80" Margin="0,0,14,0" VerticalAlignment="Center"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{l:T AllSettings.Clear}" Style="{StaticResource Ghost}" Command="{Binding Clear}" Margin="0,0,8,0" />
                <Button Content="{l:T Debloat.Apply}" Style="{StaticResource Primary}" Command="{Binding Apply}" MinWidth="120" />
            </StackPanel>
        </Grid>

        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Grid>
                <l:PageHero Title="{l:T Debloat.Title}" Subtitle="{Binding Status}" HeroMargin="36,28,330,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,36,12" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource Ghost}" Command="{Binding OpenTaskManager}" Margin="0,0,8,0" AutomationProperties.Name="{l:T Debloat.OpenStartupSettings}"
                            Visibility="{Binding InStartup, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconExternal}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T Debloat.OpenStartupSettings}" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Width="240" Tag="{l:T Debloat.Search}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T Debloat.Search}" />
                    <Button Content="{StaticResource IconRefresh}" Style="{StaticResource IconButton}" Command="{Binding Rescan}" Margin="8,0,0,0"
                            AutomationProperties.Name="{l:T Debloat.Rescan}" ToolTip="{l:T Debloat.Rescan}" />
                </StackPanel>
            </Grid>

            <Grid Margin="36,0,36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource ChipTemplate}" Tag="DebloatTab" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,4,0,0">
                    <TextBlock Text="{l:T Debloat.OnlyChangeable}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OnlyChangeable}" AutomationProperties.Name="{l:T Debloat.OnlyChangeable}" />
                </StackPanel>
            </Grid>
            <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Margin="36,8,36,0" Focusable="False" />
            <ProgressBar Style="{StaticResource Busy}" Margin="36,10,36,0" Visibility="{Binding Scanning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="36,10,24,6">
            <ListBox x:Name="List" Style="{StaticResource SelectableList}" ItemContainerStyle="{StaticResource CardItem}" ItemTemplate="{StaticResource TweakCard}"
                     ItemsSource="{Binding View}" KeyDown="OnListKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <l:EqualRowsPanel MinColumnWidth="330" MaxColumns="3" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource FlatGroupItem}">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Height="0" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
            <TextBlock Text="{l:T Debloat.NoMatch}" Style="{StaticResource Secondary}" Margin="2,20,0,0" VerticalAlignment="Top"
                       Visibility="{Binding Empty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

    </Grid>
</UserControl>
