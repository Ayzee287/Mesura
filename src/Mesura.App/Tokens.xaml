<!-- Mesura's design tokens: the palette, the glass brushes and the ambient light. Loaded before Theme.xaml (App.LoadResources) so that
     HighContrastTheme can recolour them while they are still unfrozen: a style freezes the brushes it uses the moment it loads. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===== Tokens ===== -->
    <!-- Palette (0.4 "Graphite"): a neutral near-black field, white-wash glass, one silver-blue accent for selection, focus and the primary
         action, and mint (the brand's measuring bar) only where something is verified or done. Risk and warning colours keep their meaning;
         nothing else is coloured. -->
    <Color x:Key="BgColor">#FF08090B</Color>
    <!-- Panels are washes of white over the field, never solid greys: the ambient light behind a panel shows through it, which is
         what makes the surfaces read as glass. Popups and dialogs sit over page content and are opaque (PopoverColor). -->
    <Color x:Key="SurfaceColor">#0DFFFFFF</Color>
    <Color x:Key="RaisedColor">#17FFFFFF</Color>
    <Color x:Key="HoverColor">#21FFFFFF</Color>
    <Color x:Key="PopoverColor">#FF16181C</Color>
    <!-- Hairlines are translucent white, so a border reads the same on every layer it sits on. -->
    <Color x:Key="StrokeColor">#14FFFFFF</Color>
    <Color x:Key="StrokeStrongColor">#2AFFFFFF</Color>
    <Color x:Key="TextColor">#FFF3F4F7</Color>
    <Color x:Key="TextSecondaryColor">#FFB0B5BF</Color>
    <Color x:Key="TextTertiaryColor">#FFAAB0BB</Color>
    <Color x:Key="AccentColor">#FFC6D3F0</Color>
    <Color x:Key="AccentHoverColor">#FFE2EAFA</Color>
    <Color x:Key="AccentPressedColor">#FF9FB0D6</Color>
    <Color x:Key="AccentBlueColor">#FF9DB2E6</Color>
    <Color x:Key="SuccessColor">#FF5FDDB2</Color>
    <Color x:Key="WarningColor">#FFF0B65A</Color>
    <Color x:Key="DangerColor">#FFFF8C96</Color>
    <Color x:Key="InfoColor">#FF8DB9F2</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeStrong" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtle" Color="#1FC6D3F0" />
    <SolidColorBrush x:Key="AccentRim" Color="#55C6D3F0" />
    <!-- Text and glyphs that sit on the accent fill: near-black, so the pale button reads at 12:1. -->
    <SolidColorBrush x:Key="OnAccent" Color="#FF0B0D12" />
    <SolidColorBrush x:Key="Popover" Color="{StaticResource PopoverColor}" />
    <!-- The primary action: a silver-pearl sweep with dark text; the light under it comes up on hover. -->
    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF1F4FB" Offset="0" />
        <GradientStop Color="#FFC9D4EC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFillHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFD6E0F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFillPressed" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFDCE2F0" Offset="0" />
        <GradientStop Color="#FFB4C0DC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtle" Color="#1F5FDDB2" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtle" Color="#1FF0B65A" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSubtle" Color="#1FFF7480" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSubtle" Color="#1F8DB9F2" />
    <SolidColorBrush x:Key="NeutralSubtle" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="CardHover" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="SidebarSurface" Color="#0AFFFFFF" />
    <!-- The lit rim of a glass panel: bright where light would catch the top-left edge, fading to a hairline. -->
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.4" />
        <GradientStop Color="#0EFFFFFF" Offset="0.7" />
        <GradientStop Color="#24FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- The panel's own sheen: a whisper of light from the top, so a large surface isn't one flat tone. -->
    <!-- 0.4.2: it also carries a dark scrim (about 62 % opaque), so the light behind a card shows through it without ever lifting the ground under the text: the
         captions stay above 4.5:1 at the brightest point of the light (measured on the rendered pixels, docs/redesign-0.4.md). -->
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A3282A30" Offset="0" />
        <GradientStop Color="#9E1E2024" Offset="0.5" />
        <GradientStop Color="#9E22242A" Offset="1" />
    </LinearGradientBrush>
    <!-- The command dock: denser than a card, because it floats over the page content and must stay readable over it. -->
    <LinearGradientBrush x:Key="DockSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0202328" Offset="0" />
        <GradientStop Color="#F0151719" Offset="1" />
    </LinearGradientBrush>
    <!-- The atmosphere behind everything (AmbientField, 0.4.4): every layer a soft gradient with no edge, a few percent over the ground at its brightest. A key
         light (silver-blue), a safelight (the violet of the logo), a haze (its mint), a pale diagonal beam, the dust motes and a vignette. Stops are spread
         like a gaussian, so there is no visible rim and little banding on a dark ground. -->
    <RadialGradientBrush x:Key="AmbientKey" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2E86A2F4" Offset="0" />
        <GradientStop Color="#2486A2F4" Offset="0.18" />
        <GradientStop Color="#1686A2F4" Offset="0.38" />
        <GradientStop Color="#0A86A2F4" Offset="0.6" />
        <GradientStop Color="#0386A2F4" Offset="0.8" />
        <GradientStop Color="#0086A2F4" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientSafelight" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#4CA070FF" Offset="0" />
        <GradientStop Color="#2EA070FF" Offset="0.2" />
        <GradientStop Color="#16A070FF" Offset="0.45" />
        <GradientStop Color="#06A070FF" Offset="0.7" />
        <GradientStop Color="#00A070FF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientHaze" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2C34F0B0" Offset="0" />
        <GradientStop Color="#1634F0B0" Offset="0.25" />
        <GradientStop Color="#0A34F0B0" Offset="0.5" />
        <GradientStop Color="#0334F0B0" Offset="0.75" />
        <GradientStop Color="#0034F0B0" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="AmbientBeam" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00C8D8FF" Offset="0.30" />
        <GradientStop Color="#06C8D8FF" Offset="0.40" />
        <GradientStop Color="#0EC8D8FF" Offset="0.47" />
        <GradientStop Color="#1AC8D8FF" Offset="0.50" />
        <GradientStop Color="#0EC8D8FF" Offset="0.53" />
        <GradientStop Color="#06C8D8FF" Offset="0.60" />
        <GradientStop Color="#00C8D8FF" Offset="0.70" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AmbientMote" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#D8DCE6FF" Offset="0" />
        <GradientStop Color="#70DCE6FF" Offset="0.4" />
        <GradientStop Color="#00DCE6FF" Offset="1" />
    </RadialGradientBrush>
    <!-- The room's edges fall into the dark: clear in the middle, a little over a third black in the corners. -->
    <RadialGradientBrush x:Key="AmbientVignette" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.78" RadiusY="0.78">
        <GradientStop Color="#00000000" Offset="0.45" />
        <GradientStop Color="#18000000" Offset="0.7" />
        <GradientStop Color="#40000000" Offset="0.9" />
        <GradientStop Color="#60000000" Offset="1" />
    </RadialGradientBrush></ResourceDictionary>
