<!-- Templates the pages share: the result banner, a setting's details, a plan row, a step line. Built from Theme.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Mesura.App">

    <l:ToneGlyphConverter x:Key="ToneGlyph" />

    <!-- An app, pictured the same way on every page: its packaged icon, or the neutral tile with its initial. -->
    <Style TargetType="{x:Type l:AppGlyph}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type l:AppGlyph}">
                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="9"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Image Source="{TemplateBinding Icon}" Margin="{TemplateBinding Padding}" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}" />
                            <Viewbox Margin="{TemplateBinding Padding}" Stretch="Uniform"
                                     Visibility="{Binding HasIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Presence}, ConverterParameter=invert}">
                                <TextBlock Text="{TemplateBinding Initial}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                                           Margin="3,0,3,1" Foreground="{StaticResource TextSecondary}" />
                            </Viewbox>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The result of a run, with Undo and Details when they apply; raw messages stay behind "Technical details". -->
    <DataTemplate x:Key="BannerTemplate" DataType="{x:Type l:Banner}">
        <Border Style="{StaticResource Banner}" Background="{Binding Tone, Converter={StaticResource StateBackground}}"
                Visibility="{Binding Visible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Tone, Converter={StaticResource ToneGlyph}}" FontSize="16"
                           Foreground="{Binding Tone, Converter={StaticResource StateBrush}}" VerticalAlignment="Top" Margin="0,2,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,4,0,0" LineHeight="18"
                               Visibility="{Binding Detail, Converter={StaticResource Presence}}" />
                    <Expander Style="{StaticResource Disclosure}" Header="{l:T Details.Technical}" Margin="0,6,0,0"
                              Visibility="{Binding Technical, Converter={StaticResource Presence}}">
                        <TextBlock Text="{Binding Technical}" Style="{StaticResource Mono}" LineHeight="17" />
                    </Expander>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,-4,-6,-4">
                    <Button Content="{l:T Undo.Action}" Command="{Binding Undo}" Margin="0,0,6,0"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{l:T Common.Details}" Style="{StaticResource Ghost}" Command="{Binding Details}"
                            Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{StaticResource IconClose}" Style="{StaticResource IconButton}" FontSize="11" Command="{Binding Close}" AutomationProperties.Name="{l:T Common.Dismiss}"
                            ToolTip="{l:T Common.Dismiss}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A setting's details, on demand: what it does, its trade-offs, when it takes effect, the exact changes. -->
    <DataTemplate x:Key="SettingDetails" DataType="{x:Type l:SettingRow}">
        <StackPanel>
            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
            <Border Style="{StaticResource Inset}" Background="{StaticResource WarningSubtle}" Margin="0,10,0,0"
                    Visibility="{Binding HighRiskNote, Converter={StaticResource Presence}}">
                <TextBlock Text="{Binding HighRiskNote}" Style="{StaticResource Caption}" Foreground="{StaticResource Warning}" />
            </Border>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{l:T Details.State}" Style="{StaticResource Tertiary}" Margin="0,0,16,4" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" Foreground="{Binding StateTone, Converter={StaticResource StateBrush}}" />
                    <TextBlock Text="{Binding ShortReason, StringFormat=' · {0}'}" Style="{StaticResource Caption}"
                               Visibility="{Binding ShortReason, Converter={StaticResource Presence}}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{l:T Details.When}" Style="{StaticResource Tertiary}" Margin="0,0,16,4"
                           Visibility="{Binding When, Converter={StaticResource Presence}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding When}" Style="{StaticResource Caption}" Margin="0,0,0,4"
                           Visibility="{Binding When, Converter={StaticResource Presence}}" />
                <TextBlock Grid.Row="2" Text="{l:T Details.Scope}" Style="{StaticResource Tertiary}" Margin="0,0,16,4"
                           Visibility="{Binding Scope, Converter={StaticResource Presence}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Scope}" Style="{StaticResource Caption}" Margin="0,0,0,4"
                           Visibility="{Binding Scope, Converter={StaticResource Presence}}" />
                <TextBlock Grid.Row="3" Text="{l:T Details.Kind}" Style="{StaticResource Tertiary}" Margin="0,0,16,4" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Caption}" Margin="0,0,0,4">
                    <Run Text="{Binding RecommendationText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ImpactText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Row="4" Text="{l:T Details.Benefit}" Style="{StaticResource Tertiary}" Margin="0,0,16,4"
                           Visibility="{Binding Operation.Applicable, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BenefitText}" Style="{StaticResource Caption}" Margin="0,0,0,4"
                           Visibility="{Binding Operation.Applicable, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Row="5" Text="{l:T Details.ValueBasis}" Style="{StaticResource Tertiary}" Margin="0,0,16,4"
                           Visibility="{Binding ValueBasisText, Converter={StaticResource Presence}}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ValueBasisText}" Style="{StaticResource Caption}" Margin="0,0,0,4"
                           Visibility="{Binding ValueBasisText, Converter={StaticResource Presence}}" />
                <TextBlock Grid.Row="6" Text="{l:T Details.Risk}" Style="{StaticResource Tertiary}" Margin="0,0,16,4"
                           Visibility="{Binding Operation.Applicable, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Caption}" Margin="0,0,0,4"
                           Visibility="{Binding Operation.Applicable, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="{Binding RiskText, Mode=OneWay}" Foreground="{Binding RiskTone, Converter={StaticResource StateBrush}}" /><Run Text=" · " /><Run Text="{Binding RiskWhy, Mode=OneWay}" />
                </TextBlock>
            </Grid>
            <TextBlock Text="{l:T Details.Limitations}" Style="{StaticResource Tertiary}" Margin="0,10,0,2"
                       Visibility="{Binding Limitations, Converter={StaticResource Presence}}" />
            <TextBlock Text="{Binding Limitations}" Style="{StaticResource Caption}" LineHeight="18"
                       Visibility="{Binding Limitations, Converter={StaticResource Presence}}" />
            <TextBlock Text="{l:T Details.Consequence}" Style="{StaticResource Tertiary}" Margin="0,10,0,2"
                       Visibility="{Binding Consequence, Converter={StaticResource Presence}}" />
            <TextBlock Text="{Binding Consequence}" Style="{StaticResource Caption}" LineHeight="18"
                       Visibility="{Binding Consequence, Converter={StaticResource Presence}}" />
            <TextBlock Text="{l:T Details.Restore}" Style="{StaticResource Tertiary}" Margin="0,10,0,2"
                       Visibility="{Binding Restore, Converter={StaticResource Presence}}" />
            <TextBlock Text="{Binding Restore}" Style="{StaticResource Caption}" LineHeight="18"
                       Visibility="{Binding Restore, Converter={StaticResource Presence}}" />
            <TextBlock Text="{l:T Details.Steps}" Style="{StaticResource Tertiary}" Margin="0,10,0,4"
                       Visibility="{Binding Steps, Converter={StaticResource Presence}}" />
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="5" Height="5" Fill="{StaticResource TextTertiary}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,6,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Caption}" LineHeight="18" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Style="{StaticResource Disclosure}" Header="{l:T Details.Technical}" Margin="0,8,0,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,0,0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TechnicalReason}" Style="{StaticResource Mono}" Margin="0,4,0,0"
                               Visibility="{Binding TechnicalReason, Converter={StaticResource Presence}}" />
                    <TextBlock Text="{Binding Source}" Style="{StaticResource Tertiary}" Margin="0,8,0,0" LineHeight="17"
                               Visibility="{Binding Source, Converter={StaticResource Presence}}" />
                    <TextBlock Text="{Binding Id}" Style="{StaticResource Mono}" Foreground="{StaticResource TextTertiary}" Margin="0,6,0,0" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </DataTemplate>

    <!-- A row of the Optimize plan: tick, name and one line, tags, and the details on demand. -->
    <DataTemplate x:Key="PlanItemTemplate" DataType="{x:Type l:PlanItem}">
        <Border Style="{StaticResource Row}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Included}" VerticalAlignment="Top" Margin="0,2,14,0"
                          AutomationProperties.Name="{Binding Row.Name}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Row.Name}" Style="{StaticResource Body}" />
                    <TextBlock Text="{Binding Row.Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <ContentControl Content="{Binding Row}" ContentTemplate="{StaticResource SettingDetails}" Margin="0,12,0,4"
                                    Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibility}}" Focusable="False" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,1,4,0">
                    <Border Style="{StaticResource Tag}" Background="{StaticResource WarningSubtle}" Margin="0,0,6,0"
                            Visibility="{Binding Row.NeedsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:T Common.NeedsAdmin}" Style="{StaticResource TagText}" Foreground="{StaticResource Warning}" />
                    </Border>
                    <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Visibility="{Binding Row.NeedsRestart, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:T Common.Restart}" Style="{StaticResource TagText}" />
                    </Border>
                    <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Background="{Binding Row.RiskTone, Converter={StaticResource StateBackground}}"
                            Visibility="{Binding Row.ShowRisk, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Row.RiskWhy}">
                        <TextBlock Text="{Binding Row.RiskText}" Style="{StaticResource TagText}" Foreground="{Binding Row.RiskTone, Converter={StaticResource StateBrush}}" />
                    </Border>
                    <Border Style="{StaticResource Tag}">
                        <TextBlock Text="{Binding Row.ImpactText}" Style="{StaticResource TagText}" />
                    </Border>
                </StackPanel>
                <ToggleButton Grid.Column="3" Style="{StaticResource ChevronToggle}" IsChecked="{Binding Expanded}" VerticalAlignment="Top"
                              ToolTip="{l:T Common.Details}" AutomationProperties.Name="{l:T Common.Details}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A line of a step or a run: a coloured dot (or the app's icon) and the text; a raw message shows on hover. -->
    <DataTemplate x:Key="StepLineTemplate" DataType="{x:Type l:StepLine}">
        <Grid Margin="0,3" ToolTip="{Binding Technical}" ToolTipService.IsEnabled="{Binding HasTechnical}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="7" Height="7" Fill="{Binding Tone, Converter={StaticResource StateBrush}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"
                     Visibility="{Binding AppId, Converter={StaticResource Presence}, ConverterParameter=invert}" />
            <Grid Visibility="{Binding AppId, Converter={StaticResource Presence}}" Margin="0,0,8,0" VerticalAlignment="Top">
                <l:AppGlyph AppId="{Binding AppId}" Label="{Binding AppName}" Width="20" Height="20" Padding="2" />
                <Ellipse Width="7" Height="7" Fill="{Binding Tone, Converter={StaticResource StateBrush}}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-2,-2" Stroke="{StaticResource Surface}" StrokeThickness="1.5" />
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" LineHeight="18" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <!-- A filter chip bound to a FilterChoice. -->
    <DataTemplate x:Key="ChipTemplate" DataType="{x:Type l:FilterChoice}">
        <RadioButton Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                     GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
    </DataTemplate>
</ResourceDictionary>
