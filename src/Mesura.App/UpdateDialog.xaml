<Window x:Class="Mesura.App.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Mesura.App"
        Width="560" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        KeyDown="OnKeyDown" Style="{StaticResource AppWindow}" Background="Transparent">
    <!-- The update dialog: what is new (the release notes, in the app's language), what it will do, and the choices. It follows the
         update view model live, so the download's progress and a failure show here without a second window. -->
    <Border Background="{StaticResource Popover}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="18" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid Margin="26,24,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" Width="44" Height="44" Background="{StaticResource AccentSubtle}" BorderThickness="0">
                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconUpdate}" FontSize="19" Foreground="{StaticResource AccentHover}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource SectionTitle}" FontSize="18" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" FontSize="11" VerticalAlignment="Top" Click="OnClose"
                        AutomationProperties.Name="{l:T Common.Close}" ToolTip="{l:T Common.Close}" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Inset}" Margin="0,18,0,0" Padding="16,12" MaxHeight="260">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{l:T Update.WhatsNew}" Style="{StaticResource GroupLabel}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Secondary}" Foreground="{StaticResource Text}" LineHeight="20" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <StackPanel Visibility="{Binding Downloading, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Style="{StaticResource Meter}" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
                <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource BannerTemplate}" Focusable="False" />
                <TextBlock Text="{l:T Update.Safe}" Style="{StaticResource Tertiary}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17" />
            </StackPanel>

            <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{Binding InstallLabel}" Command="{Binding Install}" MinWidth="150"
                        Visibility="{Binding CanChooseNow, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Content="{l:T Common.Cancel}" Style="{StaticResource Ghost}" Command="{Binding CancelDownload}" Margin="0,0,8,0"
                        Visibility="{Binding Downloading, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Left" Content="{l:T Update.RemindTomorrow}" Style="{StaticResource Ghost}" Command="{Binding Later}"
                        Visibility="{Binding CanChooseNow, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Left" Content="{l:T Update.SkipVersion}" Style="{StaticResource Ghost}" Command="{Binding Skip}" Margin="4,0,0,0"
                        Visibility="{Binding CanChooseNow, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
