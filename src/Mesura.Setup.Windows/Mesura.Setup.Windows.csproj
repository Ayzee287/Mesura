<Project Sdk="Microsoft.NET.Sdk">

  <!-- The change component: the personal setup layer that installs apps, imports app settings and keeps a history of
       what it changed. It is a separate project so the diagnostic code (Core, Platform.Windows) keeps its read-only
       boundary untouched (architecture §2.3, §18; D015). The same BannedSymbols.txt applies here, so every write and
       every process launch still goes through one named owner: SetupStore (files) and WingetRunner (winget). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Mesura.Setup.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mesura.Core\Mesura.Core.csproj" />
    <!-- AMD's ADLX objects (read in Platform) are written here, in the change component (0.6, GPU settings). -->
    <ProjectReference Include="..\Mesura.Platform.Windows\Mesura.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mesura.Setup.Tests" />
  </ItemGroup>

  <!-- UI Automation (the client side, UIAutomationClient) to drive NVCleanstall's window by AutomationId: the WPF part of the desktop runtime, referenced alone. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <!-- WMI for the licensing owner (LicensingWriter, D031); the same package and version as Platform. -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>


  <!-- The bonus cursor pack (W11 Cursors Light Free v2.2 by Jepri Creations, attribution in THIRD-PARTY-NOTICES.md): 17 small files carried inside the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Bonus\Cursors\*" LogicalName="Mesura.Setup.Bonus.Cursors.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
