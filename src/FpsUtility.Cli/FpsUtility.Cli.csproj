<Project Sdk="Microsoft.NET.Sdk">

  <!-- x64 only (D008). CET compatibility keeps the SDK default: CETCompat is never set to false (D010).
       Single-file publishing is set here, not on the command line, so that building and publishing restore
       the same packages and the lock files never change between them (a changed lock file marks the build
       as uncommitted, and a fixture then can't name its commit). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FpsUtility.Cli</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <!-- The snapshot's app.commit must name the commit that produced the binary. A build from a working
       tree with uncommitted changes has its stamp marked ".dirty", which Program.ReadAppInfo records
       as "no single commit" instead of claiming HEAD. -->
  <Target Name="MarkUncommittedBuild" AfterTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' != ''">
    <Exec Command="git status --porcelain" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatusOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitStatusExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitStatusExitCode)' == '0' and '$(_GitStatusOutput)' != ''">
      <SourceRevisionId>$(SourceRevisionId).dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- The Track A kit's operator files sit next to the exe in the publish folder, which is then the portable kit
       (architecture §4.7). They are separate files, not bundled into the single-file exe. -->
  <ItemGroup>
    <None Include="TrackA\Kit\*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FpsUtility.Core\FpsUtility.Core.csproj" />
    <ProjectReference Include="..\FpsUtility.Platform.Windows\FpsUtility.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
