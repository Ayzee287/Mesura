    {
      "id": "manual.vrr-sync-setup", "name": "Set up G-SYNC/FreeSync, V-Sync and a frame cap", "category": "Drivers (manual)",
      "impact": "gaming", "summary": "No tearing and no V-Sync lag on a G-SYNC or FreeSync display.",
      "description": "On a variable-refresh (G-SYNC or FreeSync) display, the combination that avoids tearing without adding V-Sync lag: VRR on, V-Sync on in the driver and off in the game, and a frame rate kept just under the refresh rate. Smoothness and latency, not frame rate.",
      "risk": "manual",
      "limitations": "Vendor guidance, not measured by Mesura. Without VRR, V-Sync off (accepting tearing) or a cap that divides the refresh rate are the usual choices. Windowed VRR can make some apps flicker.",
      "source": "NVIDIA 'System latency optimization guide' (with G-SYNC and V-Sync on, Reflex or Ultra Low Latency caps the frame rate below refresh); AMD GPUOpen Anti-Lag 2 SDK (its limiter is optional and set by the game).",
      "manual": {
        "steps": [
          "Check Windows runs the display at its highest refresh rate: Settings > System > Display > Advanced display.",
          "Turn on the display's VRR in its on-screen menu, then G-SYNC (NVIDIA app or Control Panel) or FreeSync (AMD Software).",
          "In the driver, set V-Sync on; in each game, set V-Sync off.",
          "NVIDIA: in games that offer Reflex, turn it on (otherwise set Low Latency Mode to Ultra per game); with G-SYNC and V-Sync on, either keeps the frame rate under the refresh rate by itself.",
          "AMD, or games without Reflex: cap the frame rate about 3 fps below the refresh rate, in the game or with AMD's frame rate target (FRTC) or Chill. Anti-Lag 2 lowers latency but doesn't cap the frame rate.",
          "To undo, set each item back; nothing here is changed by Mesura."
        ],
        "links": [ "https://www.nvidia.com/en-us/geforce/guides/system-latency-optimization-guide/" ]
      }
    },
