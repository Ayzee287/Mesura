      }
    },
    {
      "id": "manual.vrr-sync-setup", "name": "Set up G-SYNC/FreeSync, V-Sync and a frame cap", "category": "Drivers (manual)",
      "impact": "performance", "summary": "No tearing and no V-Sync lag on a G-SYNC or FreeSync display.",
      "description": "On a variable-refresh (G-SYNC or FreeSync) display, the combination that avoids tearing without adding V-Sync lag: VRR on, V-Sync on in the driver and off in the game, and a frame rate kept just under the refresh rate. Smoothness and latency, not frame rate.",
      "risk": "manual",
      "limitations": "Vendor guidance, not measured by Mesura. Without VRR, V-Sync off (accepting tearing) or a cap that divides the refresh rate are the usual choices. Windowed VRR can make some apps flicker.",
      "source": "NVIDIA 'System latency optimization guide' (with G-SYNC and V-Sync on, Reflex or Ultra Low Latency caps the frame rate below refresh); AMD GPUOpen Anti-Lag 2 SDK (its limiter is optional and set by the game). Added in the 2026-10-22 audit; AMD step corrected in its review.",
      "manual": {
        "steps": [
          "Check Windows runs the display at its highest refresh rate: Settings > System > Display > Advanced display.",
          "Turn on the display's VRR in its on-screen menu, then G-SYNC (NVIDIA app or Control Panel) or FreeSync (AMD Software).",
          "In the driver, set V-Sync on; in each game, set V-Sync off.",
          "NVIDIA: in games that offer Reflex, turn it on (otherwise set Low Latency Mode to Ultra per game); with G-SYNC and V-Sync on, either keeps the frame rate under the refresh rate by itself.",
          "AMD, or games without Reflex: cap the frame rate about 3 fps below the refresh rate, in the game or with AMD's frame rate target (FRTC) or Chill. Anti-Lag 2 lowers latency but doesn't cap the frame rate.",
          "To undo, set each item back; nothing here is changed by Mesura."
        ],
        "links": [ "https://www.nvidia.com/en-us/geforce/guides/system-latency-optimization-guide/" ]
      }
    },
    {
      "id": "manual.gpu-driver-ddu", "name": "Clean GPU driver reinstall with DDU", "category": "Drivers (manual)",
      "impact": "system", "summary": "Removes every trace of a broken driver before a fresh one.",
      "description": "Display Driver Uninstaller removes every trace of a graphics driver so a fresh one installs cleanly. For a broken driver or a switch between GPU brands, not for routine updates.",
      "risk": "manual",
      "limitations": "Removes the driver's settings and profiles. A BitLocker-encrypted PC may ask for its recovery key when started in Safe Mode.",
      "source": "Wagnardsoft 'DDU guide' (Safe Mode recommended; not needed for routine updates); winget Wagnardsoft.DisplayDriverUninstaller 18.1.5.3 (read 2026-10-22). Added in the 2026-10-22 audit.",
      "manual": {
        "steps": [
          "Download the new driver and DDU (wagnardsoft.com, or winget install --exact --id Wagnardsoft.DisplayDriverUninstaller). Note your BitLocker recovery key if the PC uses BitLocker.",
          "Disconnect from the internet (or use DDU's option that stops Windows Update fetching a driver).",
          "Restart into Safe Mode, run DDU, choose the GPU and its vendor, then 'Clean and restart'.",
          "Install the new driver, reconnect, and set your driver settings again."
        ],
        "links": [ "https://www.wagnardsoft.com/content/ddu-guide-tutorial" ]
      }
    },
    {
      "id": "manual.nvidia-clean-driver", "name": "Install a trimmed NVIDIA driver with NVCleanstall", "category": "Drivers (manual)",
      "impact": "system", "summary": "Build the driver without the parts you don't use.",
      "description": "Builds an NVIDIA driver package without the components you don't use (the NVIDIA App, telemetry, USB-C, HD audio if unused). Fewer background components; not a frame-rate change.",
      "risk": "manual",
      "limitations": "Without the NVIDIA App you lose its settings (G-SYNC, DLSS overrides) except through the Control Panel or Profile Inspector. A clean installation resets driver settings; Setup backs your NVIDIA profiles up first and puts them back after. Your component and tweak configuration is on Setup's NVIDIA card.",
      "source": "TechPowerUp NVCleanstall (winget TechPowerUp.NVCleanstall 1.19.0; 'mesura apps install --id nvcleanstall'). GeForce Experience left the driver in 566.36; the NVIDIA App replaced it.",
      "manual": {
        "steps": [
          "Install NVCleanstall: Setup's NVIDIA step does it (or mesura apps install --id nvcleanstall --apply).",
          "Run it, choose the driver version, and tick the components and tweaks of your NVIDIA configuration (Setup, NVIDIA card).",
          "Let it build the package and run the installer; choose a clean installation if you are replacing an older driver.",
          "Restart Windows when the installer asks, then set your driver settings again."
        ],
        "links": [ "https://www.techpowerup.com/nvcleanstall/" ]
      }
    },
    {
      "id": "manual.nvidia-profile-inspector", "name": "Tune a game profile with NVIDIA Profile Inspector", "category": "Drivers (manual)",
      "impact": "performance", "summary": "Change a game's driver settings the NVIDIA app doesn't show.",
      "description": "Edits per-game NVIDIA driver profile settings that the NVIDIA App doesn't expose.",
      "risk": "manual",
      "limitations": "Driver-profile settings are vendor configuration (reassessment R4). For one game, edit its own profile rather than the Base Profile, which applies to every app. Setup imports the profile your NVIDIA configuration names after a driver install, and backs your own profiles up first. A clean driver install resets profiles.",
      "source": "Orbmu2k NVIDIA Profile Inspector 3.x (winget Orbmu2k.nvidiaProfileInspector 3.0.2.3, command 'nvpi', read 2026-10-22)",
      "manual": {
        "steps": [
          "Install it (winget install --exact --id Orbmu2k.nvidiaProfileInspector, or mesura apps install --id nvpi --apply) and run 'nvpi'.",
          "Pick the game's profile, then use 'Export current profile' to keep a copy of how it was.",
          "Change only the settings you mean to test, then 'Apply changes'.",
          "To undo, import the exported profile or use 'Restore current profile to NVIDIA defaults'."
        ],
        "links": [ "https://github.com/Orbmu2k/nvidiaProfileInspector" ]
      }
    },
