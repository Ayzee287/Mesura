    {
      "id": "manual.startup-apps", "name": "Review the apps that start with Windows", "category": "System",
      "impact": "performance", "summary": "Fewer apps in the background and a quicker sign-in.",
      "description": "Apps that start at sign-in run in the background while you play. Turning off the ones you don't need makes sign-in quicker and leaves fewer background processes; no frame-rate claim.",
