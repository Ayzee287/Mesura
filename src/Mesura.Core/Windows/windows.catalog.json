      "registry": [
        {
          "hive": "HKLM",
          "path": "SOFTWARE\\Policies\\Microsoft\\FindMyDevice",
          "name": "AllowFindMyDevice",
          "type": "dword",
          "value": "0"
        }
      ]
    },
    {
      "id": "edge.no-microsoft-rewards",
