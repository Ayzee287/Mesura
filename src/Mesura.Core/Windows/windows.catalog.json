    },
    {
      "id": "privacy.no-cross-device-experiences", "name": "Turn off cross-device experiences (policy)", "category": "Privacy",
      "impact": "privacy", "benefit": "documented", "summary": "This PC can't take part in 'continue on another device' features.",
      "description": "Stops this PC being discoverable by your other Windows devices and from taking part in cross-device experiences (continuing what you were doing on another device), for every user of this PC. A privacy choice, not a speed-up.",
      "risk": "systemConfiguration", "valueBasis": "documented", "activation": "reboot", "minBuild": 19041, "requires": [ "proEdition" ],
      "limitations": "A Group Policy value. Microsoft lists it for Pro, Enterprise and Education, so on Home the operation doesn't apply. It applies from Windows 10 2004 with the 2021 update (KB5005101) and on Windows 11. When the policy isn't set, Windows' own behaviour depends on the edition, so Mesura counts it as set only when it is 0.",
      "source": "Microsoft Learn Policy CSP ADMX_GroupPolicy 'Continue experiences on this device' (EnableCDP): HKLM\\Software\\Policies\\Microsoft\\Windows\\System\\EnableCdp, disabled = the device isn't discoverable and can't take part in cross-device experiences; takes effect on reboot. A commercial tweak utility offers 'Disable Shared Experiences' (its script isn't available). Added in the 2026-10-25 audit follow-up.",
      "registry": [ { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "EnableCdp", "type": "dword", "value": "0" } ]
    },
    {
      "id": "privacy.diagnostic-data-required", "name": "Send required diagnostic data only (policy)", "category": "Privacy",
      "impact": "privacy", "benefit": "documented", "summary": "Windows sends the required diagnostic data and not the optional kind.",
      "description": "Sets Windows' diagnostic data to Required, the level Microsoft documents as the default: optional diagnostic data (how you use apps and features, browsing in Edge, enhanced error reports) is not sent. The data Windows needs for security, updates and reliability is still sent: Windows has no setting that stops it on Pro or Home, and this entry doesn't claim otherwise.",
      "risk": "systemConfiguration", "valueBasis": "documented", "activation": "reboot", "requires": [ "proEdition" ],
      "limitations": "A Group Policy value: Settings shows 'Send optional diagnostic data' as managed by your organisation and you can't switch it back on there while this is set. Windows Insider Preview builds need the optional data (Microsoft's Insider data settings page), so a PC in the Insider programme stops getting builds. Microsoft lists the policy for Pro, Enterprise, Education and IoT Enterprise, so on Home the operation doesn't apply. The Security level (0) exists on Enterprise, Education and Server only and equals Required elsewhere, so Mesura writes 1, never 0. Edge, Microsoft 365 and other apps have diagnostic settings of their own.",
      "source": "Microsoft Learn Policy CSP System, AllowTelemetry (Group Policy 'Allow Diagnostic Data', HKLM\\Software\\Policies\\Microsoft\\Windows\\DataCollection\\AllowTelemetry; 1 = Required, the default; 0 = Security, Enterprise/Education/Server only; 3 = Optional); Microsoft Learn 'Configure Windows diagnostic data in your organization'; Windows Insider 'data settings'. Added in the 2026-10-25 profile review.",
      "registry": [ { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "type": "dword", "value": "1" } ]
    },
