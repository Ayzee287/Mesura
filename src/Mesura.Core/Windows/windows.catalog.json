    {
      "id": "manual.bios-memory-profile", "name": "Enable the memory's XMP/EXPO profile", "category": "Firmware (manual)",
      "impact": "performance", "summary": "Run your memory at its rated speed.",
      "description": "Desktop memory rated above the standard (JEDEC) speed runs at the standard speed until its XMP (Intel) or EXPO (AMD) profile is enabled in the BIOS. Laptops and many prebuilt PCs don't offer this.",
      "risk": "manual",
      "limitations": "A profile runs the memory beyond the standard specification: Intel notes it may reduce stability and may affect warranty. A BIOS update or CMOS reset turns it off again.",
      "source": "Intel 'What is Intel Extreme Memory Profile (XMP)'; board vendors' manuals; architecture section 6.5, check 4",
      "manual": {
        "steps": [
          "Note the rated speed on the memory's label or box, and check Task Manager > Performance > Memory > Speed.",
          "Restart into the BIOS/UEFI setup (usually Del or F2 at power-on).",
          "Find the memory profile setting (XMP, EXPO, DOCP or A-XMP, often under AI Tweaker, Extreme Tweaker or OC) and select profile 1.",
          "Save and exit. If the PC fails to start, it resets to defaults after a few attempts, or clear CMOS as the board manual says.",
          "In Windows, check the speed again. If games or apps crash afterwards, run a memory test or turn the profile off."
        ],
        "links": [ "https://www.intel.com/content/www/us/en/gaming/extreme-memory-profile-xmp.html", "Your motherboard's manual (memory or overclocking chapter)" ]
      }
    },
    {
      "id": "manual.bios-resizable-bar", "name": "Enable Resizable BAR", "category": "Firmware (manual)",
      "impact": "performance", "summary": "Let the processor reach all of the GPU's memory.",
      "description": "Lets the CPU address all of the graphics card's memory at once. Supported cards (GeForce RTX 30 and later, Radeon RX 6000 and later, Intel Arc) gain in some games; Intel Arc needs it for its expected performance.",
      "risk": "manual",
      "limitations": "Needs a supporting CPU, motherboard BIOS and graphics card firmware. Turning CSM off makes a Windows installed in legacy (MBR) mode unbootable until it is converted to GPT. A few games run slower with it; NVIDIA enables it per game through its driver profiles.",
      "source": "NVIDIA 'GeForce RTX 30 Series Resizable BAR support'; Intel Arc support article 000092416; AMD calls it Smart Access Memory; Microsoft Learn MBR2GPT.",
      "manual": {
        "steps": [
          "Check whether it is already on: NVIDIA Control Panel > System Information > Resizable BAR, AMD Software > Performance > Smart Access Memory, or Intel Graphics Software.",
          "If BitLocker or device encryption is on (manage-bde -status, or Settings > Privacy & security > Device encryption), save the recovery key and suspend protection first: switching to UEFI can trigger BitLocker recovery.",
          "Check System Information > BIOS Mode. If it says Legacy, convert the system disk first with MBR2GPT (Microsoft Learn; with BitLocker suspended, then delete and recreate its protectors as that page says), or CSM can't be turned off.",
          "In the BIOS/UEFI setup, turn CSM off and enable 'Above 4G Decoding' and 'Re-Size BAR Support' (names vary; usually under PCI subsystem or Advanced). Update the BIOS first if the options are missing.",
          "Save and restart, then confirm it shows as enabled in the GPU's control panel."
        ],
        "links": [ "https://www.nvidia.com/en-us/geforce/news/geforce-rtx-30-series-resizable-bar-support/", "https://www.intel.com/content/www/us/en/support/articles/000092416/graphics.html", "https://learn.microsoft.com/windows/deployment/mbr-to-gpt" ]
      }
    },
    {
      "id": "manual.bios-update", "name": "Update the BIOS/UEFI firmware", "category": "Firmware (manual)",
      "impact": "system", "summary": "Bug fixes and support for newer hardware.",
      "description": "Firmware updates fix bugs and add support such as Resizable BAR and newer memory and CPUs. Not a performance setting.",
      "risk": "manual",
      "limitations": "An interrupted update can leave the board unbootable; laptops update on AC power only. An update resets BIOS settings such as XMP/EXPO and Resizable BAR, and without suspending BitLocker first it triggers BitLocker recovery (Microsoft's BitLocker recovery overview).",
      "source": "Board and laptop makers' support pages; Windows Update > Optional updates carries firmware for many laptops. Added in the 2026-10-22 audit.",
      "manual": {
        "steps": [
          "Run msinfo32 and note the BIOS Version/Date and the System Model.",
          "On the maker's support page for that exact model, compare the latest BIOS and read its notes.",
          "Laptops and prebuilt PCs: prefer the maker's updater or Windows Update > Advanced options > Optional updates. Desktops: use the board's own flash tool from the BIOS, as its manual says.",
          "If BitLocker or device encryption is on, save the recovery key and suspend protection before flashing (manage-bde -protectors -disable C: -RebootCount 3, or Suspend protection in Control Panel); it resumes by itself.",
          "Keep the PC on AC power and don't interrupt the update. Afterwards, re-check XMP/EXPO and Resizable BAR."
        ],
        "links": [ "Your PC's or motherboard's support page" ]
      }
    },
    {
      "id": "manual.chipset-driver", "name": "Install the current chipset driver", "category": "Drivers (manual)",
      "impact": "system", "summary": "Power and platform drivers as the maker intends.",
