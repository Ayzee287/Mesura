    {
      "id": "edge.no-background-mode",
      "name": "Stop Edge running after its last window closes",
      "category": "Microsoft Edge",
      "impact": "performance",
      "summary": "Edge exits fully when you close the last window instead of staying in the tray.",
      "description": "With background mode on, Edge starts at sign-in and keeps running after the last window is closed, so background apps and session cookies stay active, with an icon in the system tray. This sets the Edge policy BackgroundModeEnabled to 0, which turns background mode off, so closing the last window ends the Edge process.",
      "risk": "systemConfiguration",
      "level": "safe",
      "benefit": "unverified",
      "valueBasis": "documented",
      "activation": "immediate",
      "limitations": "Edge will show 'Managed by your organization' and the background-apps switch in edge://settings/system is locked. Sites and web apps that rely on Edge staying alive (push notifications, installed web apps, background sync) stop receiving anything while Edge is closed. Supported from Edge 77. Microsoft documents registry-based Edge policy for domain-joined or Intune-enrolled devices; on a standalone PC confirm in edge://policy that it is applied. Microsoft's page says that when not configured the mode is initially off and the user can change it, so on many PCs this only locks the existing state. Microsoft does not publish the resource cost of the background process.",
      "source": "Microsoft Learn, Edge policy BackgroundModeEnabled: 'Allows Microsoft Edge processes to start at OS sign-in and keep running after the last browser window is closed... An open background process displays an icon in the system tray'; REG_DWORD under HKLM\\SOFTWARE\\Policies\\Microsoft\\Edge; Windows Edge 77 and later.",
      "sources": [
        "https://learn.microsoft.com/en-us/deployedge/microsoft-edge-policies/backgroundmodeenabled",
        "https://learn.microsoft.com/en-us/deployedge/configure-microsoft-edge"
      ],
      "registry": [
        {
          "hive": "HKLM",
          "path": "SOFTWARE\\Policies\\Microsoft\\Edge",
          "name": "BackgroundModeEnabled",
          "type": "dword",
          "value": "0"
        }
      ]
    },
    {
