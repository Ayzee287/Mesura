    {
      "id": "system.ntfs-last-access-off", "name": "Turn off NTFS last-access time updates", "category": "System",
      "impact": "performance", "benefit": "unverified", "summary": "NTFS stops logging last-access times on disk.",
      "description": "Stops NTFS updating the Last Access Time stamp when folders are listed. Microsoft says this reduces the impact of logging those updates and improves the speed of file and folder access, without saying by how much; Mesura hasn't measured it. File queries stay accurate, because NTFS keeps the true value in memory.",
      "risk": "systemConfiguration", "valueBasis": "documented", "activation": "reboot",
      "limitations": "Takes effect after a restart. Microsoft notes it can affect programs that rely on the stamp, such as backup and Remote Storage. Mesura sets only the 'updates off' bit and keeps the value's other bits, so on a PC where Windows manages the value (it reads 0x80000002 on the Windows 11 test PC) that setting is kept, and revert restores the exact previous value. No gain is claimed.",
      "source": "Microsoft Learn 'fsutil behavior': disablelastaccess 1 disables updates to the Last Access Time stamp when directories are listed on an NTFS volume (HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem\\NtfsDisableLastAccessUpdate); 'Disabling the Last Access Time feature improves the speed of file and directory access'; it 'can affect programs such as Backup and Remote Storage'; a restart is required. A commercial tweak utility offers 'Configure Memory Usage Behaviors' (fsutil; its script isn't available, so which fsutil settings it changes is unknown).",
      "registry": [ { "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\FileSystem", "name": "NtfsDisableLastAccessUpdate", "type": "dword", "value": "1", "setBits": 1 } ]
    },
    {
      "id": "repair.mmcss-responsiveness", "name": "Restore the CPU reserved for background tasks", "category": "Restore Windows defaults",
      "impact": "maintenance", "benefit": "documented", "summary": "Sets the multimedia scheduler's reserve back to the documented value of 20.",
      "description": "The multimedia scheduler (MMCSS) keeps a share of the processor for lower-priority work so that games and audio can't starve the rest of the system. Microsoft's documentation describes 20 (percent) as the value the scheduler falls back to, and 20 is what a stock Windows 11 PC carries (read on the Windows 11 test PC). Some tweak packs set it to 10 to give games a little more, which is exactly what the reserve is there to prevent. This puts 20 back; it undoes a tweak, and no frame-rate gain is claimed.",
      "risk": "systemConfiguration", "activation": "reboot",
      "limitations": "Already 20 on the Windows 11 test PC, and a missing value leaves the scheduler at its own baseline, so on a PC nobody tweaked nothing changes. Microsoft documents that values below 10 are clamped to 20, so a tweak to 0 already did nothing; only a value of 10 is a real change this puts back. The cited page documents what 20 means and the clamp, not that 20 is the registry default on every edition and build, so Mesura restores the intended value of 20 rather than claiming a universal default; it isn't a performance setting.",
      "source": "Microsoft Learn 'Multimedia Class Scheduler Service': HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\SystemResponsiveness, the percentage reserved for low-priority tasks, 'values below 10 and above 100 are clamped to 20'. Verified present as 20 on PC-000 (Windows 11 Pro). A commercial tweak utility offers 'Configure CPU Time for Background System Tasks' (which lowers it).",
      "registry": [ { "hive": "HKLM", "path": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile", "name": "SystemResponsiveness", "type": "dword", "value": "20", "absentMatches": true } ]
    },
    {
      "id": "manual.restore-tcp-autotuning", "name": "Turn TCP receive-window auto-tuning back to normal", "category": "Restore Windows defaults",
      "impact": "maintenance", "benefit": "documented", "summary": "Undoes a tweak that caps download speed.",
      "description": "Tweak packs often turn TCP receive-window auto-tuning off, which keeps the receive window small: downloads slow down on fast or distant connections. Normal is Windows' default. It does nothing for game traffic, which mostly uses UDP.",
      "risk": "systemConfiguration", "activation": "immediate",
      "limitations": "Normal on a PC nobody tweaked: nothing changes there. Mesura reads every TCP setting template and counts it as done only when all of them are at Normal; the change goes through netsh, the way tweak packs make it. A Group Policy that sets the level overrides it. Untested on a tweaked PC: checked read-only on the Windows 11 test PC. (The id still says 'manual' because profiles and history name it.)",
      "source": "Microsoft Learn 'TCP/IP performance known issues': slow throughput on high-latency, high-bandwidth links when window scaling is off; fix: 'netsh int tcp set global autotuninglevel=normal'. The Registry Tweaks corpus's 'APPLY ALL BCD TWEAKS' and 'AutoTuning.bat' set it to disabled. Read through MSFT_NetTCPSetting (AutoTuningLevelLocal 3 = Normal on PC-000, every template).",
      "tcp": [ { "name": "autotuninglevel", "value": "normal" } ]
    },
    {
      "id": "repair.tcp-rss", "name": "Turn receive-side scaling back on", "category": "Restore Windows defaults",
      "impact": "maintenance", "benefit": "documented", "summary": "Spreads network receive work over the CPU cores again.",
      "description": "Receive-side scaling lets Windows process incoming network traffic on several CPU cores. Some tweak tools turn it off, which puts all of it on one core: on a fast wired connection that core can become the limit. On is Windows' default.",
      "risk": "systemConfiguration", "activation": "immediate",
      "limitations": "On by default: on a PC nobody tweaked, nothing changes. Wi-Fi adapters don't use RSS, and a wired adapter's own RSS property (in its driver settings) stays as it is. Untested on a tweaked PC: checked read-only on the Windows 11 test PC.",
      "source": "Microsoft Learn 'TCP/IP performance known issues' (only CPU 0 busy at high throughput; fix: 'netsh int tcp set global rss=enabled'). A commercial tweak utility offers 'Enable Receive Side Scaling (RSS)'. Read through MSFT_NetOffloadGlobalSetting.ReceiveSideScaling (1 = Enabled on PC-000).",
      "tcp": [ { "name": "rss", "value": "enabled" } ]
    },
    {
      "id": "repair.tcp-rsc", "name": "Turn receive segment coalescing back on", "category": "Restore Windows defaults",
      "impact": "maintenance", "benefit": "documented", "summary": "Lets Windows handle large downloads with less CPU again.",
      "description": "Receive segment coalescing combines a stream of incoming TCP segments so Windows handles one header instead of many, which saves CPU time on large downloads. Some tweak tools turn it off in the hope of lower latency; game traffic is mostly UDP, which it doesn't touch. On is Windows' default.",
      "risk": "systemConfiguration", "activation": "immediate",
      "limitations": "On by default: on a PC nobody tweaked, nothing changes. A network adapter that doesn't support RSC is unaffected. Untested on a tweaked PC: checked read-only on the Windows 11 test PC.",
      "source": "Microsoft Learn 'Overview of receive segment coalescing' (coalescing reduces per-packet processing overhead). A commercial tweak utility offers 'Disable Receive Side Coalescing (RSC)'. Read through MSFT_NetOffloadGlobalSetting.ReceiveSegmentCoalescing (1 = Enabled on PC-000).",
      "tcp": [ { "name": "rsc", "value": "enabled" } ]
    },
    {
      "id": "repair.ipv6-components", "name": "Turn IPv6 back on", "category": "Restore Windows defaults",
      "impact": "maintenance", "benefit": "documented", "summary": "Undoes a tweak that turned IPv6 off.",
      "description": "Some tweak tools turn IPv6 off with the DisabledComponents value. Microsoft doesn't recommend it: some Windows components may stop working, and the wrong value delays every start-up by five seconds. This clears the bits that turn IPv6 parts off; if the value also asks Windows to prefer IPv4 (the setting Microsoft recommends instead), that preference is kept.",
      "risk": "systemConfiguration", "activation": "reboot",
      "limitations": "Not set on a PC nobody tweaked: nothing changes there. Needs a restart. An adapter where IPv6 was unticked by hand stays unticked.",
      "source": "Microsoft Learn 'Configure IPv6 for advanced users' (KB 929852): DisabledComponents default 0x00; 'We don't recommend that you disable IPv6'; 'Prefer IPv4 over IPv6' (0x20) recommended instead; 0xFFFFFFFF delays start-up 5 s; restart required. A commercial tweak utility offers 'Disable IPv6'. Absent on PC-000.",
      "registry": [ { "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Services\\Tcpip6\\Parameters", "name": "DisabledComponents", "type": "dword", "value": "0", "absentMatches": true, "clearBits": 4294967263 } ]
    },
    {
      "id": "security.defender-status", "name": "Microsoft Defender status", "category": "Security (information)",
      "impact": "maintenance", "summary": "Microsoft Defender's state.",
      "description": "Microsoft Defender Antivirus. Guided: Mesura shows the service's start type and any policy values that switch Defender off, and opens Windows Security, where you check or change protection. Heavily stripped Windows images may not carry Defender at all.",
      "risk": "observe",
      "source": "service WinDefend; Defender policy values; Windows Security. Mesura does not script this: tamper protection blocks a registry or service write, so the reliable, reversible change is the one you make in Windows Security. The start type isn't the real-time protection state.",
      "observe": {
        "service": "WinDefend",
        "reads": [
          { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows Defender", "name": "DisableAntiSpyware", "type": "dword", "value": "0" },
          { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection", "name": "DisableRealtimeMonitoring", "type": "dword", "value": "0" }
        ],
        "openUri": "windowsdefender://threat",
        "consequence": "Real-time protection turned off in Windows Security is temporary: Windows turns it back on after a while. With Defender removed or disabled by policy and nothing else installed, the PC has no antivirus. Only run without one if you use a replacement you trust.",
        "restore": "Windows Security > Virus & threat protection > Manage settings > Real-time protection On. Policy values (DisableAntiSpyware, DisableRealtimeMonitoring) are ignored or override the toggle; remove them with gpedit or regedit."
      }
    },
    {
      "id": "security.memory-integrity-status", "name": "Memory integrity (HVCI) status", "category": "Security (information)",
      "impact": "maintenance", "summary": "Memory integrity (HVCI).",
      "description": "Memory integrity (HVCI), a Core isolation feature. Guided: Mesura shows its configured state and any policy that sets it, and opens Core isolation (on images without Windows Security the link doesn't open). Some older drivers block it; some anti-cheat (Riot Vanguard, FACEIT) may require it on. Microsoft says it can cost some performance in some gaming configurations.",
      "risk": "observe",
      "source": "DeviceGuard scenario and policy keys (Microsoft Learn 'Enable virtualization-based protection of code integrity'); Riot 'Vanguard security requirements'. Mesura does not script this: the change needs a restart and can be refused while an incompatible driver is loaded, so the Windows control is the reliable path. The values shown are the configuration, not the running state.",
      "observe": {
        "reads": [
          { "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity", "name": "Enabled", "type": "dword", "value": "0" },
          { "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity", "name": "Locked", "type": "dword", "value": "0" },
          { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeviceGuard", "name": "EnableVirtualizationBasedSecurity", "type": "dword", "value": "0" },
          { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeviceGuard", "name": "HypervisorEnforcedCodeIntegrity", "type": "dword", "value": "0" }
        ],
        "openUri": "windowsdefender://coreisolation",
        "consequence": "Removes a kernel exploit mitigation, and needs a restart. Turn it off only if a driver you need requires it; check first that your games' anti-cheat doesn't require it on.",
        "restore": "Windows Security > Device security > Core isolation details > Memory integrity On, then restart. A DeviceGuard policy, if shown, overrides the toggle."
      }
    },
    {
