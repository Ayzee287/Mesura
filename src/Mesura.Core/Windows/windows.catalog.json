  "presets": [
    {
      "id": "recommended-gaming", "name": "Recommended", "tier": "primary",
      "summary": "Everyday Windows with less promotion, ad profiling and nagging, and nothing you would miss.",
      "description": "Windows as you use it every day, minus what is there to sell or to ask for: no tips, suggestions, setup prompts or lock-screen and Start promotions, no advertising ID or tailored offers, no feedback prompts, no accessibility-shortcut prompts in the middle of a game, websites can't read your language list, and Windows sends only its required diagnostic data. Game Mode stays on and two Windows defaults are put back if a tweak tool changed them (the internet connectivity check and threaded DPCs; they change nothing on an untouched PC). Every setting is either documented by Microsoft or was checked on a Windows build, nothing here removes a feature you would use, and each setting can be undone from Activity. Optimisation is not the aim and no frame-rate gain is claimed. Windows keeps sending the data it requires for security, updates and reliability, and Edge, Microsoft 365 and other apps keep their own settings. The diagnostic-data policy needs Windows Pro or higher and administrator rights. Microsoft-documented policies add to this (Windows Pro and higher): the Customer Experience Improvement Program and application telemetry off, extra diagnostic logs and crash dumps limited, inking and typing data not sent, third-party Spotlight suggestions and search highlights off; Edge sends only required diagnostic data; long file paths on.",
      "operations": [ "input.accessibility-shortcuts-off", "notifications.no-feedback-prompts", "privacy.no-language-list", "repair.ncsi-active-probing",
                      "repair.threaded-dpc", "privacy.diagnostic-data-required", "privacy.no-advertising-id", "privacy.no-tailored-experiences",
                      "notifications.no-tips-and-suggestions", "notifications.no-setup-nags", "lockscreen.no-spotlight-ads", "start.no-recommendations",
                      "start.no-account-notifications", "gaming.game-mode-on", "telemetry.ceip-policy-off", "telemetry.application-telemetry-off",
                      "telemetry.limit-diagnostic-logs", "telemetry.limit-dump-collection", "privacy.no-inking-typing-data-upload",
                      "suggestions.no-third-party-in-spotlight", "search.no-highlights-policy", "edge.diagnostic-data-required", "system.long-paths-on" ]
    },
    {
      "id": "maximum-performance", "name": "Maximum performance", "tier": "primary",
      "summary": "Recommended, plus fewer optional background functions and desktop power settings, with the trade-offs named.",
      "description": "Everything in Recommended, plus a more aggressive cut of what runs or reports in the background, and desktop power settings: Windows stops creating error reports, recording activity history, taking part in cross-device features, sharing updates with other PCs, tracking app launches, learning from your typing and showing Widgets; and on AC power the High performance plan, PCI Express links and drives stay at full power. Each addition is documented by Microsoft and can be undone from Activity. What you give up is named in each entry: no automatic crash reports, no Start 'most used apps' or Run history, no 'continue on another device', more idle power, heat and fan noise. No reputable measurement shows a frame-rate gain from these on current hardware; the aim is a PC that does less on its own, not a speed claim. On a laptop the plan and PCI Express entries don't apply (they would cost battery life), on a Modern Standby PC the plan doesn't (Windows offers only Balanced there), and on Windows Home the policy entries don't apply. Offered unticked: the unofficial telemetry controls (turning off the telemetry service and Windows' data-collection tasks, which Microsoft doesn't document as a way to reduce diagnostic data), online speech recognition, all app notifications, no USB selective suspend (Microsoft recommends leaving it on; for a device that misbehaves), hardware-accelerated GPU scheduling (a restart; needed for DLSS Frame Generation) and no NTFS last-access updates (a restart; can affect backup tools). Settings known only from community sources are never part of it. Also, documented policies for the rest of what reports or advertises: cross-device clipboard, personalised website recommendations in Start, Settings tips, Edge background mode, startup boost, Microsoft content and PDF prompts, OneDrive sign-in prompts; 6to4/ISATAP tunnels and Remote Assistance off; on a desktop, an energy preference that favours performance on AC. Offered unticked: the telemetry service and tasks, online speech, notifications, USB keep-awake, hardware scheduling, no last-access updates.",
      "operations": [ "input.accessibility-shortcuts-off", "notifications.no-feedback-prompts", "privacy.no-language-list", "repair.ncsi-active-probing",
                      "repair.threaded-dpc", "privacy.diagnostic-data-required", "privacy.no-advertising-id", "privacy.no-tailored-experiences",
                      "notifications.no-tips-and-suggestions", "notifications.no-setup-nags", "lockscreen.no-spotlight-ads", "start.no-recommendations",
                      "start.no-account-notifications", "gaming.game-mode-on", "privacy.no-error-reporting", "privacy.no-activity-history",
                      "privacy.no-cross-device-experiences", "privacy.no-app-launch-tracking", "privacy.no-typing-personalization", "updates.no-p2p-delivery",
                      "taskbar.widgets-policy-off", "power.high-performance", "power.pcie-aspm-off", "power.disk-never-off", "telemetry.ceip-policy-off",
                      "telemetry.application-telemetry-off", "telemetry.limit-diagnostic-logs", "telemetry.limit-dump-collection", "privacy.no-inking-typing-data-upload",
                      "suggestions.no-third-party-in-spotlight", "search.no-highlights-policy", "edge.no-startup-boost", "edge.diagnostic-data-required",
                      "system.long-paths-on", "privacy.no-settings-online-tips", "start.no-personalized-website-recommendations", "edge.no-microsoft-newtab-content",
                      "edge.no-default-pdf-prompts", "onedrive.no-existing-account-sign-in-prompts", "privacy.no-cross-device-clipboard", "edge.no-background-mode",
                      "network.ipv6-6to4-isatap-off", "network.remote-assistance-off", "power.cpu-epp-performance-ac" ],
      "optional": [ "services.telemetry-off", "tasks.telemetry-off", "privacy.no-online-speech", "notifications.off", "power.usb-keep-awake",
                  "gpu.hardware-scheduling-on", "system.ntfs-last-access-off" ]
    },
    {
      "id": "gaming", "name": "Gaming input and sound", "tier": "collection",
      "summary": "Game Mode, no mouse acceleration, End task, no audio ducking.",
      "description": "Opt-in gaming preferences: Game Mode kept on (Windows' default), no accessibility-shortcut prompts, game audio not lowered during calls, no mouse acceleration, End task on taskbar menus. Some stored values are community-documented (see each entry). No power-plan changes: High performance and USB power changes were removed on 2026-10-22 (no measured gain, and they cost laptops battery).",
      "operations": [ "gaming.game-mode-on", "input.accessibility-shortcuts-off", "audio.no-ducking", "input.pointer-precision-off", "taskbar.end-task" ]
    },
    {
      "id": "quiet", "name": "Quiet Windows", "tier": "collection",
      "summary": "No tips, promotions, notification sounds or ad tracking.",
      "description": "No tips, suggestions or promoted apps, no sync-provider notices, no notification sounds, no search highlights; advertising ID, tailored experiences and the language list for websites off.",
      "operations": [ "notifications.no-tips-and-suggestions", "notifications.no-sync-provider-ads", "notifications.no-sound", "lockscreen.no-spotlight-ads", "notifications.no-setup-nags", "notifications.no-feedback-prompts", "privacy.no-advertising-id", "privacy.no-tailored-experiences", "privacy.no-language-list", "search.no-highlights" ]
    },
    {
      "id": "clean-taskbar", "name": "Clean taskbar and Start", "tier": "collection",
      "summary": "A cleaner taskbar and Start, without recommendations.",
      "description": "Task View and Chat off the taskbar; no recommendations, account prompts, search highlights or recently opened files in Start. How search looks on the taskbar is left to you (icon or hidden), and Widgets are left to the Widgets policy operation.",
      "operations": [ "taskbar.hide-task-view", "taskbar.hide-chat", "start.no-recommendations", "start.no-account-notifications", "search.no-highlights", "start.no-recent-items" ]
    },
    {
      "id": "network-defaults", "name": "Network defaults back", "tier": "collection",
      "summary": "Undoes network tweaks: auto-tuning, RSS, RSC, IPv6, the connectivity check.",
      "description": "Puts Windows' own network defaults back where a tweak tool changed them: TCP receive-window auto-tuning at Normal, receive-side scaling and receive segment coalescing on, IPv6 not turned off, and the internet connectivity check on. Each is documented by Microsoft and is Windows' default, so on a PC nobody tweaked nothing changes. Added in the 2026-10-24 quality pass after comparing network tweaks in a commercial tweak utility and the owner's corpus: none of their other network tweaks (Nagle, TCP timers and ports, MTU, adapter buffers and interrupts, BBRv2, QoS reserve) is documented, measured or safe enough for Mesura.",
      "operations": [ "manual.restore-tcp-autotuning", "repair.tcp-rss", "repair.tcp-rsc", "repair.ipv6-components", "repair.ncsi-active-probing" ]
    },
    {
      "id": "system-defaults", "name": "System defaults back", "tier": "collection",
      "summary": "Undoes tweak-pack changes to scheduling, memory and prefetch.",
      "description": "Puts the intended Windows values back where a tweak tool changed them: threaded DPCs on, the multimedia scheduler's reserve for background work at 20, the memory manager favouring programs over the file cache, and boot and app-launch prefetch on. Each undoes a tweak and is not a performance setting; none claims a frame-rate gain. On a PC nobody tweaked nothing changes. Not in Recommended on purpose: these are corrections for a PC a tweak tool changed, not settings every gaming PC needs, and none has a documented effect on games (the two Recommended repairs, threaded DPCs and the connectivity check, also appear here). Added in the 2026-10-25 audit follow-up to give these repairs a home beside the network ones.",
      "operations": [ "repair.threaded-dpc", "repair.mmcss-responsiveness", "repair.large-system-cache", "repair.prefetcher", "cpu.platform-clock-default",
                      "cpu.dynamic-tick-default", "cpu.win32-priority-separation-default" ]
    },
    {
      "id": "less-data-sharing", "name": "Less data sharing", "tier": "collection",
      "summary": "Advertising ID, activity history, crash reports and other optional data sharing off.",
      "description": "Turns off optional data sharing with Microsoft and websites: optional diagnostic data, the advertising ID, tailored experiences, the language list sent to websites, app-launch tracking, typing and inking personalisation, online speech recognition, activity history, Windows Error Reporting and cross-device experiences. These are privacy choices, not speed-ups, and some are policies for the whole PC (Pro, Enterprise and Education). The first group overlaps Recommended and Maximum performance; this collection is the way to apply them without the rest. Windows keeps sending the diagnostic data it requires, and Edge, Microsoft 365 and other apps have settings of their own.",
      "operations": [ "privacy.diagnostic-data-required", "privacy.no-advertising-id", "privacy.no-tailored-experiences", "privacy.no-language-list", "privacy.no-app-launch-tracking", "privacy.no-typing-personalization", "privacy.no-online-speech", "privacy.no-activity-history", "privacy.no-error-reporting", "privacy.no-cross-device-experiences" ]
    },
    {
      "id": "ghost-spectre-superlite", "name": "Ghost Spectre Superlite follow-up", "tier": "specialized",
      "summary": "What a Ghost Spectre Superlite image still leaves to do.",
      "description": "What a Superlite image still leaves to do (checked against a 25H2 Superlite install, 2026-09-24): tips and suggestions and lock-screen tips (left on by the image), Start recommendations and recently opened files (not set by the image), setup nags and search highlights (not recorded at install), and the System Event Notification Service the image disables. Most of these stored values are community-documented; this is the owner's own follow-up list, read on that install. The image already hides Task View, the Copilot button and account prompts, shows file extensions, turns Game DVR off and removes OneDrive, so those aren't here. For a gaming PC, apply Recommended too. Preferences (search style, where Explorer opens, the classic right-click menu) are left to you.",
      "operations": [ "notifications.no-tips-and-suggestions", "lockscreen.no-spotlight-ads", "start.no-recommendations", "start.no-recent-items", "notifications.no-setup-nags", "search.no-highlights", "services.sens-on" ]
    },
    {
      "id": "edge-policies", "name": "Quieter Microsoft Edge", "tier": "collection",
      "summary": "Edge without startup boost, background mode, shopping, sidebar or promotions.",
      "description": "Microsoft's own Edge policies: no startup boost or background mode, no shopping assistant, sidebar, Microsoft content on the new tab page, feature recommendations, Rewards or first-run screens; optional diagnostic data off; sleeping tabs on. Edge says it is managed by your organisation while these are set; they are documented and undo cleanly.",
      "operations": [ "edge.no-startup-boost", "edge.no-feature-recommendations", "edge.diagnostic-data-required", "edge.no-spotlight-recommendations",
                      "edge.no-microsoft-newtab-content", "edge.no-default-pdf-prompts", "edge.no-background-mode", "edge.no-shopping-assistant",
                      "edge.no-personalization-reporting", "edge.no-sidebar", "edge.sleeping-tabs-on", "edge.no-microsoft-rewards", "edge.hide-first-run" ]
    },
    {
      "id": "privacy-policies", "name": "Less data leaving this PC", "tier": "collection",
      "summary": "Documented privacy policies: telemetry programs, sync, search, suggestions.",
      "description": "Microsoft-documented policies (Windows Pro and higher): the Customer Experience Improvement Program, application telemetry, the inventory collector, extra diagnostic logs and dumps, OneSettings downloads, inking and typing data, settings sync, cross-device clipboard, cloud and location use in Search, third-party suggestions and online tips. Some features that need the data stop working; each entry says which.",
      "operations": [ "telemetry.ceip-policy-off", "telemetry.application-telemetry-off", "telemetry.limit-diagnostic-logs", "telemetry.limit-dump-collection",
                      "privacy.no-inking-typing-data-upload", "suggestions.no-third-party-in-spotlight", "search.no-location", "search.no-highlights-policy",
