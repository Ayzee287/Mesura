    {
      "id": "edge.no-startup-boost",
      "name": "Turn off Edge startup boost",
      "category": "Microsoft Edge",
      "impact": "performance",
      "summary": "Stops Edge from starting its processes at sign-in and relaunching them in the background.",
      "description": "Startup boost lets Microsoft Edge start processes when you sign in to Windows and restart them in the background after the last window is closed, so the browser opens faster. This sets the Edge policy StartupBoostEnabled to 0 (disabled), which turns startup boost off. Microsoft documents the policy, its registry value and its meaning; it does not publish how much memory or CPU the idle processes use.",
      "risk": "systemConfiguration",
      "level": "safe",
      "benefit": "unverified",
      "valueBasis": "documented",
      "activation": "immediate",
      "limitations": "Edge will show 'Managed by your organization' and the Startup boost switch in edge://settings/system is locked. The first Edge launch after sign-in can be slower. The effect on free memory or game performance is not measured by Microsoft and is not claimed here. Supported from Edge 88. Microsoft documents registry-based Edge policy for domain-joined or Intune-enrolled devices; on a standalone PC check edge://policy and confirm the policy is listed as applied, not blocked. Edge applies the change without a restart, but processes already running stay until Edge is closed. Not configured means Edge decides (Microsoft says it may be on or off initially).",
      "source": "Microsoft Learn, Edge policy StartupBoostEnabled: 'Allows Microsoft Edge processes to start at OS sign-in and restart in background after the last browser window is closed'; registry HKLM\\SOFTWARE\\Policies\\Microsoft\\Edge, REG_DWORD, 0 disables it, Windows Edge 88 and later. Policy-on-registry scope from Microsoft Learn 'Configure Microsoft Edge for Windows with policy settings'.",
      "sources": [
        "https://learn.microsoft.com/en-us/deployedge/microsoft-edge-policies/startupboostenabled",
        "https://learn.microsoft.com/en-us/deployedge/configure-microsoft-edge"
      ],
      "registry": [
        {
          "hive": "HKLM",
          "path": "SOFTWARE\\Policies\\Microsoft\\Edge",
          "name": "StartupBoostEnabled",
          "type": "dword",
          "value": "0"
        }
      ]
    },
    {
