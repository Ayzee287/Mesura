  "presets": [
    {
      "id": "recommended-gaming", "name": "Mesura Reference", "tier": "primary",
      "summary": "The safe basics in three parts: performance, privacy, fewer promotions.",
      "description": "Mesura's own baseline: eighteen documented settings that apply to almost every PC, in three parts you can also apply one by one. Performance: Game Mode on, the accessibility shortcuts that interrupt a game off, and two Windows defaults that tweak packs often change (the connectivity check, threaded DPCs) put back. Privacy: no advertising ID, tailored experiences or language list for websites, required diagnostic data only, no improvement programs or app telemetry. Fewer promotions: no tips, suggestions, setup prompts or lock-screen and Start ads. Nothing here touches power, services, security or drivers, and none of it claims a frame-rate gain: it is about what Windows shows, sends and settles on, not speed. Machine policies need Windows Pro.",
      "operations": [ "gaming.game-mode-on", "input.accessibility-shortcuts-off", "privacy.no-advertising-id", "privacy.no-tailored-experiences",
                      "privacy.no-language-list", "privacy.diagnostic-data-required", "telemetry.ceip-policy-off", "telemetry.application-telemetry-off",
                      "notifications.no-feedback-prompts", "notifications.no-tips-and-suggestions", "notifications.no-setup-nags", "lockscreen.no-spotlight-ads",
                      "start.no-recommendations", "start.no-account-notifications", "suggestions.no-third-party-in-spotlight", "search.no-highlights-policy",
                      "repair.ncsi-active-probing", "repair.threaded-dpc" ]
    },
    {
      "id": "maximum-performance", "name": "Maximum performance", "tier": "primary",
      "summary": "Mesura Reference, plus the background work and desktop power settings a performance-minded PC can do without; the trade-offs are named.",
      "description": "Everything in Mesura Reference, plus changes that keep a desktop out of its power-saving states and stop background components nobody asked for. On a desktop on AC power: the High performance plan, USB selective suspend off, no PCI Express link power saving and drives that are never switched off (a laptop would lose battery life, and a Modern Standby PC only offers Balanced, so these are skipped there). Everywhere: Windows stops running Game Bar recording and broadcasting in the background, the Widgets process, Microsoft Edge's startup boost and its background mode, and stops sharing downloaded updates with other PCs. You give up automatic energy saving at idle (more heat, fan noise and electricity), Game Bar clips and widgets. Not ticked, offered beside it because they depend on the hardware or on taste: hardware-accelerated GPU scheduling (restart; needed for DLSS Frame Generation), background recording off, the pointer-precision switch, window animations and transparency off, NTFS last-access updates off, the processor energy hint and memory compression off (16 GB or more). No reliable measurement of a frame-rate gain from any of these on current hardware exists, and none is claimed. Every value is documented by Microsoft or was checked on a real Windows build, and Undo in Activity puts it back.",
      "optional": [ "gpu.hardware-scheduling-on", "gaming.background-recording-off", "input.pointer-precision-off", "dwm.window-animations-off",
                      "visual.transparency-off", "system.ntfs-last-access-off", "power.cpu-epp-performance-ac", "memory.compression-off" ],
      "operations": [ "gaming.game-mode-on", "input.accessibility-shortcuts-off", "privacy.no-advertising-id", "privacy.no-tailored-experiences",
                      "privacy.no-language-list", "privacy.diagnostic-data-required", "telemetry.ceip-policy-off", "telemetry.application-telemetry-off",
                      "notifications.no-feedback-prompts", "notifications.no-tips-and-suggestions", "notifications.no-setup-nags", "lockscreen.no-spotlight-ads",
                      "start.no-recommendations", "start.no-account-notifications", "suggestions.no-third-party-in-spotlight", "search.no-highlights-policy",
                      "repair.ncsi-active-probing", "repair.threaded-dpc", "power.high-performance", "power.usb-keep-awake", "power.pcie-aspm-off", "power.disk-never-off",
                      "taskbar.widgets-policy-off", "edge.no-startup-boost", "edge.no-background-mode", "gaming.game-recording-policy-off", "updates.no-p2p-delivery" ]
    },
    {
      "id": "gaming", "name": "Gaming preferences", "tier": "collection",
      "summary": "Game Mode, no mouse acceleration, no audio ducking, no background recording, End task.",
      "description": "Opt-in gaming preferences: Game Mode kept on (Windows' default), no accessibility-shortcut prompts, game audio not lowered during calls, no mouse acceleration, no background recording or Game Bar recording and broadcasting, no Game Bar from the controller's Xbox button, End task on taskbar menus. Some stored values are community-documented (see each entry). No power-plan changes: High performance and USB power changes cost laptops battery and have no measured gain; they are in Maximum performance for desktops only.",
      "operations": [ "gaming.game-mode-on", "input.accessibility-shortcuts-off", "audio.no-ducking", "input.pointer-precision-off", "gaming.background-recording-off",
                      "gaming.game-recording-policy-off", "gaming.controller-game-bar-off", "taskbar.end-task" ]
    },
    {
      "id": "less-data-sharing", "name": "Less data sharing", "tier": "collection",
      "summary": "Advertising ID, activity history, crash reports, telemetry programs and cloud search off.",
      "description": "Turns off optional data sharing with Microsoft and websites: optional diagnostic data, the advertising ID, tailored experiences, the language list sent to websites, app-launch tracking, typing and inking personalisation and upload, online speech recognition, activity history, Windows Error Reporting, cross-device experiences and clipboard, settings sync, the telemetry programs (Customer Experience Improvement Program, application telemetry, the inventory collector, extra logs and dumps, OneSettings downloads), cloud content and location in Search, Click to Do and Edge's optional diagnostic data. These are privacy choices, not speed-ups; most are machine policies (Windows Pro, Enterprise and Education), and some features that need the data stop working (each entry says which). The first group overlaps Recommended and Maximum performance; this collection is the way to apply the rest. Windows keeps sending the diagnostic data it requires.",
      "operations": [ "privacy.diagnostic-data-required", "privacy.no-advertising-id", "privacy.no-tailored-experiences", "privacy.no-language-list",
                      "privacy.no-app-launch-tracking", "privacy.no-typing-personalization", "privacy.no-online-speech", "privacy.no-activity-history",
                      "privacy.no-error-reporting", "privacy.no-cross-device-experiences", "privacy.no-inking-typing-data-upload", "privacy.no-cross-device-clipboard",
                      "privacy.no-settings-sync", "telemetry.ceip-policy-off", "telemetry.application-telemetry-off", "telemetry.limit-diagnostic-logs",
                      "telemetry.limit-dump-collection", "telemetry.inventory-collector-off", "telemetry.onesettings-downloads-off", "search.no-box-suggestions",
                      "search.no-cloud-content", "search.no-location", "edge.diagnostic-data-required", "ai.click-to-do-off" ]
    },
    {
      "id": "network-defaults", "name": "Network defaults back", "tier": "collection",
      "summary": "Undoes network tweaks: auto-tuning, RSS, RSC, IPv6, the connectivity check.",
      "description": "Puts Windows' own network defaults back where a tweak tool changed them: TCP receive-window auto-tuning at Normal, receive-side scaling and receive segment coalescing on, IPv6 not turned off, and the internet connectivity check on. Each is documented by Microsoft and is Windows' default, so on a PC nobody tweaked nothing changes. Other network tweaks that circulate (Nagle, TCP timers and ports, MTU, adapter buffers and interrupts, BBRv2, QoS reserve) are not offered: none is documented, measured or safe enough.",
      "operations": [ "manual.restore-tcp-autotuning", "repair.tcp-rss", "repair.tcp-rsc", "repair.ipv6-components", "repair.ncsi-active-probing" ]
    },
    {
      "id": "system-defaults", "name": "System defaults back", "tier": "collection",
      "summary": "Undoes tweak-pack changes to scheduling, memory and prefetch.",
      "description": "Puts the intended Windows values back where a tweak tool changed them: threaded DPCs on, the multimedia scheduler's reserve for background work at 20, the memory manager favouring programs over the file cache, and boot and app-launch prefetch on. Each undoes a tweak and is not a performance setting; none claims a frame-rate gain. On a PC nobody tweaked nothing changes. Not in Recommended on purpose: these are corrections for a PC a tweak tool changed, not settings every gaming PC needs, and none has a documented effect on games (the two Recommended repairs, threaded DPCs and the connectivity check, also appear here).",
      "operations": [ "repair.threaded-dpc", "repair.mmcss-responsiveness", "repair.large-system-cache", "repair.prefetcher", "cpu.platform-clock-default",
                      "cpu.dynamic-tick-default", "cpu.win32-priority-separation-default", "services.sens-on", "services.print-on" ]
    },
    {
      "id": "reference-performance", "name": "Performance basics", "tier": "collection",
      "summary": "Game Mode on, no accessibility pop-ups in games, two defaults put back.",
      "description": "The performance part of Mesura Reference: Game Mode on, Sticky Keys and the other accessibility shortcuts off so a game is not interrupted, and the connectivity check and threaded DPCs put back to Windows' defaults if a tweak tool changed them. No frame-rate gain is claimed.",
      "operations": [ "gaming.game-mode-on", "input.accessibility-shortcuts-off", "repair.ncsi-active-probing", "repair.threaded-dpc" ]
    },
    {
      "id": "reference-privacy", "name": "Privacy basics", "tier": "collection",
      "summary": "No advertising profile, required diagnostic data only.",
      "description": "The privacy part of Mesura Reference: no advertising ID, tailored experiences or language list sent to websites, required diagnostic data only, and no Customer Experience or application telemetry programs. A privacy choice, not a speed-up. Windows keeps sending the diagnostic data it requires.",
      "operations": [ "privacy.no-advertising-id", "privacy.no-tailored-experiences", "privacy.no-language-list", "privacy.diagnostic-data-required",
                      "telemetry.ceip-policy-off", "telemetry.application-telemetry-off" ]
    },
    {
      "id": "reference-convenience", "name": "Fewer promotions", "tier": "collection",
      "summary": "No tips, suggestions, setup prompts or ads in Windows.",
      "description": "The convenience part of Mesura Reference: no feedback requests, tips and suggestions, 'finish setting up your device' screens, lock-screen ads, Start recommendations or account prompts, no third-party suggestions and no search highlights. Changes what Windows shows, nothing else.",
      "operations": [ "notifications.no-feedback-prompts", "notifications.no-tips-and-suggestions", "notifications.no-setup-nags", "lockscreen.no-spotlight-ads",
                      "start.no-recommendations", "start.no-account-notifications", "suggestions.no-third-party-in-spotlight", "search.no-highlights-policy" ]
    },
    {
      "id": "desktop-performance", "name": "Hardware-dependent tuning (desktop)", "tier": "collection",
      "summary": "AC power, scheduler and memory settings that depend on the hardware.",
      "description": "Documented processor, drive, memory and GPU settings for a desktop on AC power: unparked cores, performance-first energy preference, faster ramp-up, drives kept out of low-power idle, power throttling off, the kernel kept in RAM (16 GB or more), memory compression off (16 GB or more), no 8.3 file names, hardware-accelerated GPU scheduling, and a preference for performance cores on hybrid processors. More heat, noise and idle power; no measured frame-rate gain is claimed, and the effect differs by CPU, drive and driver.",
      "operations": [ "cpu.core-parking-off", "power.nvme-stay-active-ac", "power.cpu-epp-performance-ac", "power.cpu-ramp-up-fast-ac", "power.power-throttling-off",
                      "cpu.hybrid-prefer-performance-cores", "power.sata-link-power-off-ac", "memory.keep-kernel-in-ram", "memory.compression-off",
                      "system.ntfs-8dot3-off", "gpu.hardware-scheduling-on" ]
    },
    {
      "id": "network-adapter", "name": "Network adapter tuning (advanced)", "tier": "collection",
      "summary": "Per-adapter driver settings: interrupt moderation, EEE, selective suspend, Wi-Fi power saving.",
      "description": "Settings Microsoft documents as standardized adapter keywords, set on every adapter whose driver declares them: interrupt moderation, Energy-Efficient Ethernet, selective suspend and Wi-Fi power saving. Effects depend on the adapter and the network and can raise CPU use or power; the adapter restarts when applied. For people who measure; no gain is claimed.",
      "operations": [ "network.wifi-power-saving-max-performance", "network.interrupt-moderation-off", "network.ethernet-eee-off", "network.nic-selective-suspend-off" ]
    },
    {
      "id": "quiet-network", "name": "Less network exposure", "tier": "collection",
      "summary": "LLMNR, WPAD, SMB1, NetBIOS and tunnelling protocols off.",
      "description": "Turns off name-resolution and discovery protocols many PCs never need and attackers like: LLMNR, proxy auto-discovery (WPAD), SMB1, 6to4/ISATAP/Teredo tunnels, NetBIOS over TCP/IP and Remote Assistance. Hardening, not speed: a PC on a home or small-office network may lose name resolution of non-DNS names or old file shares; each entry says what. Left out on purpose: UPnP/SSDP and mDNS (they carry port mapping, casting and printer discovery that games and consoles use).",
      "operations": [ "network.netbios-over-tcpip-off", "network.llmnr-off", "network.ipv6-6to4-isatap-off", "network.smb1-off", "network.remote-assistance-off",
                      "network.teredo-off", "network.wpad-off" ]
    }
