      "operations": [ "notifications.no-tips-and-suggestions", "notifications.no-sync-provider-ads", "notifications.no-sound", "lockscreen.no-spotlight-ads", "notifications.no-setup-nags", "notifications.no-feedback-prompts", "privacy.no-advertising-id", "privacy.no-tailored-experiences", "privacy.no-language-list", "search.no-highlights" ]
