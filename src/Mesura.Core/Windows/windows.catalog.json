    {
      "id": "repair.threaded-dpc", "name": "Turn threaded DPCs back on", "category": "Restore Windows defaults",
      "impact": "system", "summary": "Restores threaded DPCs if a tweak tool turned them off.",
      "description": "Turns threaded DPCs back on if a tweak tool turned them off. Microsoft documents that they then run as ordinary DPCs, each of which increases system latency and can hurt audio and video playback. This undoes a tweak; it is not a performance setting, and no frame-rate effect is claimed.",
      "risk": "systemConfiguration", "valueBasis": "documented", "activation": "reboot",
      "limitations": "On by default (no value is stored): on a PC nobody tweaked, nothing changes. Where the value is 0, Mesura sets it to 1 (on).",
