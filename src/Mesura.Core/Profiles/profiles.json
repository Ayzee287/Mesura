{
  // Mesura's optimization profiles (0.6, docs/profiles-0.6.md): the two levels, as groups of entries over the Windows catalog's operations.
  // An entry only names an operation, the group it belongs to, whether it is applied with the profile ("default") or offered unticked
  // ("optional"), why it is there, and the hardware it is for ("when"). How a setting is written, read back and reverted stays in the operation.
  // Rules the tests hold: every default entry's stored value is documented, verified or confirmed by an effect check (a value known from community sources
  // only is optional); every entry says why; no text promises speed (no gain is claimed unless it was measured); the catalog presets of the same id list the
  // same operations as the default and optional entries.
  // Maximum performance is "everything that applies to this PC that is meant to make it faster, heat, noise and idle power accepted": an operation that can't
  // apply here is skipped with its reason, and one with a cost says so ("sideEffects") instead of being left out.
  // "when" is hardware relevance beyond the operation's own requirements: form (desktop, compact, portable), cpu (intel, amd, hybrid), gpu (any, discrete,
  // nvidia, amd, intel), disk (nvme, sata, ssd, hdd), network (wifi, ethernet). A fact that couldn't be read leaves the entry alone.
  "kind": "Mesura.OptimizationProfiles",
  "schemaVersion": 1,
  "groups": [
    { "id": "telemetry", "name": "Telemetry", "summary": "Windows diagnostic and usage reporting to Microsoft, off in every profile." },
    { "id": "privacy", "name": "Privacy and promotions", "summary": "Advertising profile, tips, suggestions and promotions in Windows." },
    { "id": "windows", "name": "Windows", "summary": "Background work and defaults of Windows itself." },
    { "id": "power", "name": "Power management", "summary": "The power plan and what the PC's devices may power down." },
    { "id": "cpu", "name": "Processor", "summary": "How Windows runs and schedules the processor." },
    { "id": "memory", "name": "Memory", "summary": "How Windows uses installed memory." },
    { "id": "gpu", "name": "Graphics", "summary": "The graphics driver's own switches and graphics scheduling." },
    { "id": "storage", "name": "Storage", "summary": "Drives and the file system." },
    { "id": "network", "name": "Network", "summary": "Network behaviour of Windows and the settings of the network adapter's own driver, chosen by the adapter found." },
    { "id": "gaming", "name": "Gaming and latency", "summary": "Game Mode, game recording and input behaviour." }
  ],
  "profiles": [
