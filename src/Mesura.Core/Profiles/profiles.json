{
  // Mesura's optimization profiles (0.6, docs/profiles-0.6.md): the two levels, as groups of entries over the Windows catalog's operations.
  // An entry only names an operation, the group it belongs to, whether it is applied with the profile ("default") or offered unticked
  // ("optional"), why it is there, and the hardware it is for ("when"). How a setting is written, read back and reverted stays in the operation.
  // Rules the tests hold: every default entry's stored value is documented, verified or confirmed by an effect check (a value known from community sources
  // only is optional); every entry says why; no text promises speed (no gain is claimed unless it was measured); the catalog presets of the same id list the
  // same operations as the default and optional entries.
  // Maximum performance is "everything that applies to this PC that is meant to make it faster, heat, noise and idle power accepted": an operation that can't
  // apply here is skipped with its reason, and one with a cost says so ("sideEffects") instead of being left out.
  // "when" is hardware relevance beyond the operation's own requirements: form (desktop, compact, portable), cpu (intel, amd, hybrid, x3d-dual-ccd,
  // not-x3d-dual-ccd), gpu (any, discrete, nvidia, amd, intel), disk (nvme, sata, ssd, hdd), network (wifi, ethernet). A fact that couldn't be read leaves
  // the entry alone.
  // "restrictions" (0.9) are the owner's hardware policies over operations: a listed operation is applied by a level, or from a saved PC setup (one by one
  // or through a collection), only where "when" holds. They hold for operations no level lists too, and each entry of a listed operation carries them.
  "kind": "Mesura.OptimizationProfiles",
  "schemaVersion": 1,
  "restrictions": [
    {
      // Vault D054 item 4 (owner, 2026-11-25). On a Ryzen X3D with two core dies, AMD's chipset driver parks the die without the stacked cache while a game
      // runs, and finds the game through Game Bar; forcing cores unparked, a High performance plan personality, the Game Bar recording policy or removing
      // Game Bar works against that. Windows' own High performance and Ultimate Performance plans are listed with the Maximum Mesura plan: they set the
      // same High performance personality and keep cores unparked. Both are retired from the built-in catalog since 0.9 Phase 3 (never applied from a saved
      // setup); they stay listed for an edited catalog that still carries them. A processor whose kind couldn't be read is
      // left alone (unknown is never taken as "not X3D"). Not checked on real dual-CCD X3D hardware; synthetic tests don't relax it.
      "id": "dual-ccd-x3d",
      "when": { "cpu": "not-x3d-dual-ccd" },
      "ops": [ "cpu.core-parking-off", "power.mesura-maximum-plan", "power.high-performance", "power.ultimate-performance", "gaming.game-recording-policy-off", "apps.remove-game-bar" ],
      "why": "Left out on a Ryzen X3D with two core dies, where AMD's driver parks one die for games and needs core parking and Game Bar to do it"
    }
  ],
  "groups": [
    { "id": "telemetry", "name": "Telemetry", "summary": "Windows diagnostic and usage reporting to Microsoft, off in every profile." },
    { "id": "privacy", "name": "Privacy and promotions", "summary": "Advertising profile, tips, suggestions and promotions in Windows." },
    { "id": "apps", "name": "Bundled apps", "summary": "Apps Windows installs or promotes, removed for your account; Undo registers them again." },
    { "id": "windows", "name": "Windows", "summary": "Background work and defaults of Windows itself." },
    { "id": "background", "name": "Background activity", "summary": "Windows services that work in the background, at the cost of what they provide." },
    { "id": "components", "name": "Windows components", "summary": "Optional Windows features turned off, with what each one provided." },
    { "id": "power", "name": "Power management", "summary": "The power plan and what the PC's devices may power down." },
    { "id": "cpu", "name": "Processor", "summary": "How Windows runs and schedules the processor." },
    { "id": "memory", "name": "Memory", "summary": "How Windows uses installed memory." },
    { "id": "gpu", "name": "Graphics", "summary": "The graphics driver's own switches and graphics scheduling." },
    { "id": "storage", "name": "Storage", "summary": "Drives and the file system." },
    { "id": "network", "name": "Network", "summary": "Network behaviour of Windows and the settings of the network adapter's own driver, chosen by the adapter found." },
    { "id": "security", "name": "Security trade-offs", "summary": "A protection given up for convenience, offered unticked with its cost." },
    { "id": "gaming", "name": "Gaming and latency", "summary": "Game Mode, game recording and input behaviour." }
  ],
