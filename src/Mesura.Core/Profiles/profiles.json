        { "op": "network.preset-realtek-ethernet", "group": "network", "when": { "network": "ethernet" }, "sideEffects": true },
        { "op": "network.preset-intel-ethernet", "group": "network", "when": { "network": "ethernet" }, "sideEffects": true },
        { "op": "network.preset-killer-ethernet", "group": "network", "when": { "network": "ethernet" }, "sideEffects": true },
