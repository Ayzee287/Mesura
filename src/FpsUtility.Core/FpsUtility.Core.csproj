<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0, not -windows: Core must not be able to reach an OS API (D009, architecture §3.2). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FpsUtility.Core</RootNamespace>
  </PropertyGroup>

  <!-- The Track A pipeline's failure seams (a normaliser that throws) are internal; their tests live in Core.Tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FpsUtility.Core.Tests" />
  </ItemGroup>

</Project>
