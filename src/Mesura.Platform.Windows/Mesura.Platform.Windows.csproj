<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0-windows: no higher TFM, which would pull in the unused Windows SDK projection
       (architecture §17.1). The 19045 floor is enforced by the startup platform check, not here. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Mesura.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mesura.Core\Mesura.Core.csproj" />
  </ItemGroup>

  <!-- The mapping and path rules are internal; their tests live in Platform.Tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Mesura.Platform.Tests" />
    <!-- The ADLX objects are read here and written in Setup (the change component), which is where every other setter of Mesura lives: Platform itself has no write call. -->
    <InternalsVisibleTo Include="Mesura.Setup.Windows" />
    <InternalsVisibleTo Include="Mesura.Setup.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.335" PrivateAssets="all" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
